---
import Eyebrow from "../../../components/Eyebrow.astro";
import { currentLanguage } from "../../../i18n/language";
import { FAQ, copy, localized } from "../_content";

/**
 * The questions someone asks themselves just before registering — is it for
 * me, what does it cost, what if I can't come — answered where they are asked.
 * Native <details>, so it opens without JavaScript and the answers are in the
 * page for search.
 */
const lang = currentLanguage();
const c = copy(lang);
---

<section class="sec faq" id="faq">
  <div class="wrap">
    <Eyebrow mark="ellipsis">FAQ</Eyebrow>
    <h2 class="sec-h" data-reveal="up">{c.faqHeading}</h2>

    <div class="list" data-reveal="up">
      {
        FAQ.map((item) => (
          <details>
            <summary>{localized(item.q, lang)}</summary>
            <p>{localized(item.a, lang)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-top: var(--bw) solid var(--stroke);
  }

  /* Two columns rather than one 820px-wide one: six questions in a single
     narrow stack left half the section empty and read as unfinished. Each
     item sizes to its own content, so opening one grows only its own row. */
  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 10px;
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  @media (width <= 820px) {
    .list {
      grid-template-columns: 1fr;
    }
  }

  details {
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  details[open] {
    background: var(--t-pa);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 20px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: "Q";
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 2px solid var(--stroke);
    border-radius: 50%;
    background: var(--t);
    color: var(--t-on);
    font-size: 13px;
  }

  /* A plus that turns into a cross, the brand's own glyphs for open/close. */
  summary::after {
    content: "+";
    margin-left: auto;
    font-size: 22px;
    line-height: 1;
    transition: transform 0.2s var(--ease-out);
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    margin: 0;
    padding: 0 20px 18px 60px;
    font-size: 15px;
    line-height: 1.85;
  }
</style>
