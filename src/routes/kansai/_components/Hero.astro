---
import Logo from "../../../components/Logo.astro";
import type { ResolvedTenant } from "../../../tenants";
import { getProgram } from "../../../data/program";
import { messages } from "../../../i18n";
import { currentLanguage } from "../../../i18n/language";
import { copy } from "../_content";

/**
 * Kansai's first screen.
 *
 * Set on the dark stage rather than on the page's paper, because this is the
 * one screen whose job is to announce rather than to inform: everything below
 * it is the programme, and the switch back to a light ground is what marks the
 * boundary. The four core colours read as light on it, which is the whole
 * reason the brand has a halftone set at all.
 *
 * The layout is the decision a visitor is actually making, in the order they
 * make it: what this is (the claim), when and where (the card), and what it
 * costs them to find out (the figures). The countdown lives in the card rather
 * than in a band of its own further down — urgency is worth nothing after the
 * decision has already been made.
 *
 * The scale figures are counted from the programme, not configured, so they
 * cannot drift from the timetable the visitor clicks through to.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const { event, links, tagline } = site;
const lang = currentLanguage();
const t = messages(lang);
const c = copy(lang);

const program = await getProgram(site.tenant);
const sessionCount = program.reduce(
  (total, group) => total + group.sessions.length,
  0,
);
const speakerCount = new Set(
  program.flatMap((group) =>
    group.sessions.flatMap((session) =>
      session.talks.flatMap((talk) => talk.speakers.map((s) => s.id)),
    ),
  ),
).size;

// `2026-10-18` → `10.18`, the way a conference writes its own date.
const [year, month, day] = event.isoDate.split("-");
const dayMonth = `${month}.${day}`;

/*
  The strip along the foot of the stage, sitting on the fold so that it is the
  thing that asks to be scrolled past. Four facts, each one an answer to a
  reason not to come: it is big enough to be worth the trip, there is more than
  one thing on at a time, the people are real, and it costs nothing.

  Only counts belong here — how the day is attended is a sentence rather than a
  figure, so it is in the card above with the rest of the practical detail. A
  count that has not been announced yet is dropped rather than drawn as a zero.
*/
const figures = [
  { value: String(sessionCount), label: c.statSessions, tone: "blue" },
  { value: String(program.length), label: c.statTracks, tone: "green" },
  { value: String(speakerCount), label: c.statSpeakers, tone: "yellow" },
  { value: event.fee, label: c.statFee, tone: "red" },
].filter((figure) => figure.value !== "0");

const cdCells = [
  { key: "d", label: "Days" },
  { key: "h", label: "Hours" },
  { key: "m", label: "Min" },
  { key: "s", label: "Sec" },
];
---

<section class="hero stage" id="top" data-stage>
  <div class="stage-rules" aria-hidden="true">
    <i style="--c:var(--ht-blue)"></i>
    <i style="--c:var(--ht-green)"></i>
    <i style="--c:var(--ht-yellow)"></i>
    <i style="--c:var(--ht-red)"></i>
  </div>
  <div class="stage-glow" aria-hidden="true"></div>

  <div class="wrap hero-wrap">
    <div class="hero-lay">
      <div class="hero-main">
        <div class="lockup" data-intro="1">
          <Logo variant="brackets" class="brackets" />
          <span class="yr">{year}</span>
        </div>

        <h1 data-intro="2">
          <span class="h1-claim">
            <span class="h1-lead">{tagline.lead}</span><span class="h1-accent"
              >{tagline.accent}</span
            >
          </span>
          <span class="h1-name">{site.title}</span>
        </h1>

        <p class="hero-lede" data-intro="3">{c.heroLede}</p>

        <div class="cta-row" data-intro="4">
          <div class="primary">
            <a
              class="btn big"
              href={links.register}
              target="_blank"
              rel="noopener"
              data-analytics="register_click"
              data-placement="hero"
              >{c.heroRegister}<span class="arr" aria-hidden="true">→</span></a
            >
            <p class="cta-note">{c.heroRegisterNote}</p>
          </div>
          <a class="btn ghost" href="#timetable">{c.heroTimetable}</a>
        </div>
      </div>

      <aside class="datecard" data-intro="5">
        <p class="dc-eyebrow">{c.heroDateLabel}</p>
        <p class="dc-date">
          <span class="dc-dm">{dayMonth}</span>
          <span class="dc-dow">{event.dayOfWeekEn.toUpperCase()}</span>
        </p>
        <p class="dc-hours">{event.hoursCompact} JST</p>

        <p class="dc-venue">
          {event.venue.name}
          <small>{event.venue.area}・{event.formatShort}</small>
        </p>

        <div class="dc-cd" data-countdown={event.startsAt}>
          <p class="dc-cd-h">{t.countdown.heading}</p>
          <div class="cd-row" role="timer" aria-live="off">
            {
              cdCells.map((cell) => (
                <span class="cd-cell">
                  <b data-cd={cell.key}>—</b>
                  <small>{cell.label}</small>
                </span>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </div>

  <ul class="figures" data-intro="6">
    {
      figures.map((figure) => (
        <li style={`--c:var(--ht-${figure.tone})`}>
          <b>{figure.value}</b>
          <span>{figure.label}</span>
        </li>
      ))
    }
  </ul>

  <div class="stage-hem bottom" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* The top bar sits over the stage rather than above it, so the dark runs
       to the very top of the window. */
    margin-top: calc(var(--topbar-h) * -1);
    padding-top: var(--topbar-h);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    /* The hem is drawn inside the section, so the day's last row needs to
       clear it. */
    padding-bottom: 26px;
  }

  /* Four rules leaning across the stage — the four core colours, and the four
     tracks, before there is a timetable to put them in. Scaled from the floor
     by the intro script; the resting state here is what a visitor without
     JavaScript sees. */
  .stage-rules {
    position: absolute;
    inset: -12% -20%;
    z-index: 0;
    display: flex;
    justify-content: center;
    gap: clamp(60px, 13vw, 190px);
    transform: skewX(-11deg);
    opacity: 0.5;
  }

  .stage-rules i {
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--c) 22%,
      var(--c) 72%,
      transparent
    );
  }

  /* Keeps the headline off the rules without a panel behind it. */
  .stage-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        68% 58% at 22% 42%,
        var(--stage) 38%,
        color-mix(in srgb, var(--stage) 70%, transparent) 66%,
        transparent
      ),
      radial-gradient(
        46% 40% at 88% 8%,
        color-mix(in srgb, var(--t) 22%, transparent),
        transparent 70%
      );
  }

  .hero-wrap {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    padding: clamp(26px, 3.4vw, 46px) 0 clamp(22px, 3vw, 38px);
  }

  .hero-lay {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.95fr);
    gap: clamp(26px, 4vw, 56px);
    align-items: center;
    width: 100%;
  }

  /* ---- the claim ------------------------------------------------------- */

  .lockup {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 18px);
    flex-wrap: wrap;
    margin-bottom: clamp(14px, 1.9vw, 22px);
  }

  .lockup :global(.brackets) {
    width: clamp(150px, 19vw, 215px);
    flex: none;
  }

  .yr {
    font-family: var(--f-mono);
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    line-height: 1.7;
    font-weight: 700;
    font-size: clamp(11px, 1.4vw, 13px);
    letter-spacing: 0.16em;
    background: var(--ht-yellow);
    color: var(--stage);
    padding: 2px 14px;
  }

  h1 {
    display: grid;
    gap: clamp(9px, 1.2vw, 14px);
    margin: 0 0 clamp(14px, 1.8vw, 20px);
  }

  .h1-claim {
    display: block;
    font-size: clamp(31px, 4.7vw, 58px);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .h1-lead,
  .h1-accent {
    display: block;
  }

  .h1-accent {
    color: var(--t-ht);
  }

  /* The event's own name, kept in the heading for what reads it as a document
     and sized for what reads it as a poster. */
  .h1-name {
    font-family: var(--f-mono);
    font-size: clamp(12px, 1.5vw, 14.5px);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-stage-dim);
  }

  .hero-lede {
    max-width: 40ch;
    margin: 0 0 clamp(20px, 2.4vw, 28px);
    font-size: clamp(14px, 1.4vw, 15.5px);
    line-height: 1.85;
    color: var(--on-stage-dim);
  }

  .cta-row {
    align-items: flex-start;
    gap: 14px;
  }

  .primary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* The one button on the screen that matters, a size up from the rest. On the
     stage it needs no drop shadow to separate from the ground, so it trades
     the brand's hard offset for a lift. */
  .hero :global(.btn.big) {
    font-size: 18px;
    padding: 16px 34px;
  }

  .arr {
    transition: transform 0.18s var(--ease-out);
  }

  .hero :global(.btn.big:hover) .arr {
    transform: translateX(4px);
  }

  .cta-note {
    margin: 13px 0 0 2px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--on-stage-dim);
  }

  /* ---- the date card --------------------------------------------------- */

  /* The same box as every panel on the page below — surface, 2.5px outline,
     hard offset shadow — which on the stage comes out light on dark. It was a
     blurred glass card with a hairline, and that was the single loudest thing
     saying the first screen belonged to a different site. */
  .datecard {
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: 0 5px 0 var(--stroke);
    padding: clamp(18px, 2.1vw, 25px);
  }

  .dc-eyebrow {
    margin: 0 0 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-stage-dim);
  }

  .dc-date {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
  }

  .dc-dm {
    font-family: var(--f-display);
    font-size: clamp(42px, 5.2vw, 62px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .dc-dow {
    font-family: var(--f-mono);
    font-size: clamp(14px, 1.7vw, 17px);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--t-ht);
  }

  .dc-hours {
    margin: 8px 0 0;
    font-family: var(--f-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--on-stage-dim);
  }

  .dc-venue {
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1.5px solid var(--rule);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 15.5px;
    line-height: 1.5;
  }

  .dc-venue small {
    display: block;
    margin-top: 3px;
    font-family: var(--f-body);
    font-weight: 400;
    font-size: 13px;
    color: var(--on-stage-dim);
  }

  .dc-cd {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1.5px solid var(--rule);
  }

  .dc-cd-h {
    margin: 0 0 10px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-stage-dim);
  }

  .cd-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .cd-cell {
    display: grid;
    gap: 2px;
    justify-items: start;
  }

  .cd-cell b {
    font-family: var(--f-mono);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .cd-cell small {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-stage-dim);
  }

  /* ---- the figure strip ------------------------------------------------ */

  .figures {
    position: relative;
    z-index: 1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--bw) solid var(--stroke);
  }

  .figures li {
    display: grid;
    gap: 3px;
    padding: clamp(13px, 1.6vw, 18px) clamp(12px, 2vw, 26px);
    border-left: 1.5px solid var(--rule);
  }

  .figures li:first-child {
    border-left: 0;
  }

  .figures b {
    font-family: var(--f-display);
    font-size: clamp(19px, 2.3vw, 27px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--c);
  }

  .figures span {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-stage-dim);
  }

  /* ---- narrower ---------------------------------------------------------- */

  @media (width <= 980px) {
    .hero {
      min-height: 0;
    }

    .hero-lay {
      grid-template-columns: 1fr;
      gap: clamp(26px, 5vw, 36px);
    }

    .datecard {
      max-width: 480px;
    }

    .figures {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-columns: auto;
    }

    .figures li {
      border-left: 1.5px solid var(--rule);
      border-top: 1.5px solid var(--rule);
    }

    .figures li:nth-child(odd) {
      border-left: 0;
    }

    .figures li:nth-child(-n + 2) {
      border-top: 0;
    }
  }

  @media (width <= 560px) {
    .cta-row :global(.btn) {
      width: 100%;
    }

    .primary {
      width: 100%;
    }
  }

  /* Entrance state. Cleared by the intro script; never applied without JS. */
  :global(html.js) [data-intro] {
    opacity: 0;
    transform: translateY(18px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-intro] {
      opacity: 1;
      transform: none;
    }
  }
</style>
