---
/**
 * The DF26 line symbols — the unfilled asterisk, globe, arrow and at-sign that
 * punctuate the campaign's social GIFs. Geometry is the brand sticker set's
 * own (`gdg-design` outline stickers 27, 40, 30 and 20), moved to the origin;
 * the stroke takes `currentColor`, so a glyph is inked like text.
 */
interface Props {
  name: "asterisk" | "globe" | "arrow" | "at";
  class?: string;
}

const { name, class: className } = Astro.props;

const GLYPHS = {
  asterisk: {
    viewBox: "0 0 136.5 136.5",
    move: "translate(-3071.5 -346.5)",
    body: `<line x1="3182.31" y1="457.09" x2="3097.48" y2="372.26"/><line x1="3097.48" y1="457.09" x2="3182.31" y2="372.26"/><line x1="3139.89" y1="474.66" x2="3139.89" y2="354.69"/><line x1="3079.91" y1="414.67" x2="3199.88" y2="414.67"/>`,
  },
  globe: {
    viewBox: "0 0 242 224",
    move: "translate(-2074.5 -600)",
    body: `<ellipse cx="2195.67" cy="712.07" rx="110.25" ry="101.13"/><ellipse cx="2195.67" cy="712.07" rx="47.59" ry="101.13"/><line x1="2093.16" y1="674.6" x2="2298.09" y2="674.6"/><line x1="2093.16" y1="749.37" x2="2298.09" y2="749.37"/>`,
  },
  arrow: {
    viewBox: "0 0 196.5 151.5",
    move: "translate(-2232.5 -197.5)",
    body: `<line x1="2240.97" y1="273.19" x2="2420.74" y2="273.19"/><path d="M2420.74,273.19c-37.42,0-88.8-30.13-89.49-67.45"/><path d="M2420.74,273.19c-37.45,0-88.88,30.17-89.49,67.53"/>`,
  },
  at: {
    viewBox: "0 0 141.5 156.5",
    move: "translate(-3266.5 -600)",
    body: `<path d="M3370.37,696.24c-12.05,22.43-36.58,32.58-54.79,22.67-18.21-9.91-23.2-36.14-11.15-58.57"/><path d="M3304.43,660.34c12.05-22.43,36.58-32.58,54.79-22.67,18.21,9.91,23.2,36.14,11.15,58.57"/><path d="M3387.64,705.09c-3.12,5.8-9.46,8.42-14.17,5.86-4.71-2.56-6-9.34-2.88-15.14"/><path d="M3348.33,741.57c-14.76,5.81-30.55,5.73-44.06-1.62-27.64-15.05-35.21-54.85-16.92-88.9"/><path d="M3287.35,651.04c18.29-34.05,55.53-49.46,83.17-34.41,27.64,15.05,35.21,54.85,16.92,88.9"/>`,
  },
} as const;

const glyph = GLYPHS[name];
---

<svg
  class:list={["k-glyph", className]}
  viewBox={glyph.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <g transform={glyph.move} set:html={glyph.body} />
</svg>

<style>
  .k-glyph {
    display: block;
    height: auto;
    overflow: visible;
  }
</style>
