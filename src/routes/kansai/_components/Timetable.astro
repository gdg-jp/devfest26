---
import Portrait from "./Portrait.astro";
import Panel from "./Panel.astro";
import type { ResolvedTenant } from "../../../tenants";
import { getTimetable, type TimetableCell } from "../../../data/timetable";
import { trackPastel } from "../../../data/tracks";
import { currentLanguage } from "../../../i18n/language";
import { copy } from "../_content";

/**
 * The day at a glance, drawn from the same model as every other city's
 * timetable (`src/data/timetable.ts`) — only the drawing is Kansai's.
 *
 * Wide screens get the whole grid, one column per track, rows cut wherever
 * something starts or ends. A phone gets the same cells in one column,
 * read across each row and then down: A1 B1 C1, then A2 B2 C2. A session
 * that spans several rows is listed once, where it starts.
 */
interface Props {
  site: ResolvedTenant;
  featured: readonly string[];
}

const { site, featured } = Astro.props;
const lang = currentLanguage();
const c = copy(lang);

const table = await getTimetable(site);
const featuredSet = new Set(featured);

const minutes = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return h * 60 + m;
};

const rows = table
  ? table.boundaries.slice(0, -1).map((start, i) => {
      const span = minutes(table.boundaries[i + 1]) - minutes(start);
      return `minmax(${Math.max(30, Math.round(span * 2.6))}px, auto)`;
    })
  : [];

const phoneLabel = (label: string) => label.trim().toLowerCase();

/** Dropped from the phone list. The grid still draws it. */
const hiddenOnPhone = new Set(["懇親会会場へ移動"].map(phoneLabel));

/** A break for the room, not a track. No track chip on the phone. */
const noTrackOnPhone = new Set(
  ["開場・受付", "昼休憩", "懇親会"].map(phoneLabel),
);

/**
 * Fixtures that read as sessions: a filled card, not a dashed row.
 * Matched loosely so "Fashion runway" and "fashion runway" agree.
 */
const cardOnPhone = new Set(
  [
    "調整中",
    "LT大会",
    "Findy スポンサーセッション",
    "Fashion runway",
    "写真撮影",
  ].map(phoneLabel),
);

/** Phone order: each time-row left to right, then the next row. */
const mobileCells = table
  ? [...table.cells]
      .filter((cell) => !hiddenOnPhone.has(phoneLabel(cell.label)))
      .sort((a, b) => a.rowStart - b.rowStart || a.columnStart - b.columnStart)
  : [];

const tracksOf = (cell: TimetableCell) =>
  (table?.tracks ?? []).slice(cell.columnStart - 2, cell.columnEnd - 2);

const sessionSlug = (cell: TimetableCell) => cell.key.replace(/^session:/, "");
const isFeatured = (cell: TimetableCell) =>
  cell.kind === "session" && featuredSet.has(sessionSlug(cell));
const bare = (name: string) => name.replace(/\s*氏$/, "");
---

{
  table && (
    <section
      class="k-sec k-sec--panel k-tt"
      id="timetable"
      aria-labelledby="k-tt-h"
    >
      <div class="k-wrap k-wrap--panel">
        <Panel
          title="Timetable"
          id="k-tt-h"
          tone="var(--ht-green)"
          stickers={["colon", "equals"]}
        >
          {/* ---- phone: one column, across each row then down ---------- */}
          <ol class="k-tt__list">
            {mobileCells.map((cell) => {
              const covered = tracksOf(cell);
              const key = phoneLabel(cell.label);
              const venueWide = covered.length === table.tracks.length;
              const showTracks = !noTrackOnPhone.has(key) && !venueWide;
              const asCard =
                (cell.kind === "session" && Boolean(cell.href)) ||
                cardOnPhone.has(key);
              const fill =
                cell.fill ??
                (covered[0] ? trackPastel(covered[0]) : "var(--surface)");
              const tracks = showTracks && (
                <span class="k-tt__tracks">
                  {covered.map((track) => (
                    <span
                      class="k-tt__track"
                      style={`--trk:${track.data.color}`}
                    >
                      <b>{track.data.label}</b>
                    </span>
                  ))}
                </span>
              );
              const when = (
                <time class="k-tt__slot">
                  {cell.start} - {cell.end}
                </time>
              );
              return (
                <li
                  class:list={[
                    "k-tt__row",
                    `k-tt__row--${cell.kind}`,
                    { "is-featured": isFeatured(cell) },
                  ]}
                >
                  {cell.kind === "session" && cell.href ? (
                    <a
                      class="k-tt__card"
                      href={cell.href}
                      style={`--fill:${cell.fill}`}
                    >
                      {isFeatured(cell) && (
                        <span class="k-tt__badge">{c.featuredBadge}</span>
                      )}
                      <span class="k-tt__chips">
                        {tracks}
                        {when}
                      </span>
                      <span
                        class:list={[
                          "k-tt__title",
                          {
                            "is-tbd":
                              !cell.label || cell.label.startsWith("Session"),
                          },
                        ]}
                      >
                        {cell.label || "TBA"}
                      </span>
                      <span class="k-tt__who">
                        {cell.speakers.map((s) => (
                          <span class="k-tt__person">
                            <Portrait speaker={s} size={48} class="k-tt__av" />
                            <span class="k-tt__id">
                              <span class="k-tt__name">
                                {bare(s.data.name)}
                              </span>
                              {s.data.role && (
                                <span class="k-tt__role">{s.data.role}</span>
                              )}
                            </span>
                          </span>
                        ))}
                      </span>
                    </a>
                  ) : asCard ? (
                    <div class="k-tt__card" style={`--fill:${fill}`}>
                      <span class="k-tt__chips">
                        {tracks}
                        {when}
                      </span>
                      <span class="k-tt__title">{cell.label}</span>
                      {cell.note && <small>{cell.note}</small>}
                    </div>
                  ) : (
                    <div class="k-tt__fixture">
                      <span class="k-tt__chips">
                        {tracks}
                        {when}
                      </span>
                      <span>
                        {cell.label}
                        {cell.note && <small>{cell.note}</small>}
                      </span>
                    </div>
                  )}
                </li>
              );
            })}
          </ol>

          {/* ---- wide: the whole grid ------------------------------------ */}
          <div
            class="k-tt__grid"
            style={`--tracks:${table.tracks.length};grid-template-rows:auto ${rows.join(" ")}`}
            data-k-reveal="fade"
          >
            {table.tracks.map((track, i) => (
              <div
                class="k-tt__head"
                style={`grid-column:${i + 2};--trk:${track.data.color};--trk-ink:${track.data.darkInk ? "var(--ink)" : "var(--surface)"}`}
              >
                <b>{track.data.label}</b>
              </div>
            ))}

            {table.boundaries.slice(0, -1).map((time, i) => (
              <time class="k-tt__tick" style={`grid-row:${i + 2}`}>
                {time}
              </time>
            ))}

            {table.cells.map((cell) => (
              <div
                class:list={[
                  "k-tt__cell",
                  `k-tt__cell--${cell.kind}`,
                  { "is-featured": isFeatured(cell) },
                ]}
                style={`grid-row:${cell.rowStart}/${cell.rowEnd};grid-column:${cell.columnStart}/${cell.columnEnd};--fill:${cell.fill ?? "var(--surface)"}`}
              >
                {cell.kind === "session" && cell.href ? (
                  <a class="k-tt__card" href={cell.href}>
                    <span class="k-tt__time">
                      {cell.start} – {cell.end}
                      {isFeatured(cell) && (
                        <span class="k-tt__badge">{c.featuredBadge}</span>
                      )}
                    </span>
                    <span class="k-tt__title">{cell.label || "TBA"}</span>
                    <span class="k-tt__who">
                      {cell.speakers.map((s) => (
                        <span class="k-tt__person">
                          <Portrait speaker={s} size={26} class="k-tt__av" />
                          {bare(s.data.name)}
                        </span>
                      ))}
                    </span>
                  </a>
                ) : (
                  <div class="k-tt__fixture">
                    <span>{cell.label}</span>
                    {cell.note && <small>{cell.note}</small>}
                  </div>
                )}
              </div>
            ))}
          </div>

          {table.undated.length > 0 && (
            <div class="k-tt__undated">
              <h3>{c.undated}</h3>
              <ul>
                {table.undated.map((session) => (
                  <li>
                    <a href={session.href}>
                      {session.entry.data.title ?? session.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <p class="k-tt__note">{c.timetableNote}</p>
        </Panel>
      </div>
    </section>
  )
}

<style>
  /* ---- grid (wide) -------------------------------------------------- */

  .k-tt__grid {
    display: grid;
    grid-template-columns: 64px repeat(var(--tracks), minmax(0, 1fr));
    gap: 6px 10px;
  }

  .k-tt__head {
    position: sticky;
    top: calc(var(--topbar-h, 76px) + 6px);
    z-index: 3;
    grid-row: 1;
    display: grid;
    gap: 0;
    padding: 10px 18px;
    margin-bottom: 8px;
    border: var(--k-line) solid var(--ink);
    border-radius: 999px;
    background: var(--trk);
    color: var(--trk-ink);
    line-height: 1.3;
  }

  .k-tt__head b {
    font-family: var(--k-f-display);
    font-size: 17px;
  }

  .k-tt__tick {
    grid-column: 1;
    padding-top: 4px;
    font-family: var(--f-mono);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--muted);
    border-top: 1.5px solid var(--k-hair);
  }

  .k-tt__cell {
    display: flex;
    min-width: 0;
  }

  .k-tt__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    padding: 12px 14px;
    border: var(--k-line) solid var(--ink);
    border-radius: 16px;
    background: var(--fill);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.35s var(--k-ease),
      box-shadow 0.35s var(--k-ease);
  }

  .k-tt__card:hover,
  .k-tt__card:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .is-featured .k-tt__card {
    border-width: 3px;
  }

  .k-tt__time {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* Pinned to the card's top edge, so it never squeezes the time beside it. */
  .k-tt__badge {
    position: absolute;
    right: 10px;
    top: -10px;
    border: 1.5px solid var(--ink);
    white-space: nowrap;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ht-yellow);
    font-family: var(--k-f-display);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .k-tt__title {
    font-family: var(--k-f-display);
    font-weight: 700;
    font-size: 14.5px;
    line-height: 1.45;
  }

  .is-featured .k-tt__title {
    font-size: 16px;
  }

  .k-tt__who {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: auto;
  }

  .k-tt__person {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
  }

  .k-tt__person :global(.k-tt__av) {
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    object-fit: cover;
    background: var(--surface);
    font-size: 11px;
  }

  .k-tt__fixture {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2px 12px;
    width: 100%;
    padding: 6px 12px;
    border: 1.5px dashed var(--dash);
    border-radius: 12px;
    color: var(--muted);
    font-family: var(--k-f-display);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
  }

  .k-tt__fixture small {
    font-weight: 500;
    font-size: 12px;
  }

  /* ---- list (narrow) ------------------------------------------------ */

  .k-tt__list {
    display: none;
  }

  @media (width < 900px) {
    .k-tt__grid {
      display: none;
    }

    .k-tt__list {
      display: grid;
      gap: 12px;
      margin: 0 0 24px;
      padding: 0;
      list-style: none;
    }

    .k-tt__chips {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .k-tt__tracks {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .k-tt__track {
      display: inline-flex;
      padding: 4px 12px;
      border: var(--k-line) solid var(--ink);
      border-radius: 1000px;
      background: var(--trk);
      color: var(--ink);
      font-family: var(--k-f-display);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
    }

    .k-tt__slot {
      display: inline-flex;
      padding: 3px 12px;
      border: 1.5px solid var(--ink);
      border-radius: 1000px;
      color: var(--ink);
      font-family: var(--k-f-display);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
      line-height: 1.5;
    }

    .k-tt__list .k-tt__card {
      gap: 10px;
      padding: 16px;
    }

    .k-tt__list .k-tt__title {
      color: var(--ink);
      font-size: 17px;
      line-height: 1.45;
    }

    .k-tt__list .k-tt__who {
      margin-top: 4px;
    }

    .k-tt__list .k-tt__person {
      align-items: center;
      gap: 10px;
    }

    .k-tt__list .k-tt__person :global(.k-tt__av) {
      width: 48px;
      height: 48px;
      border-radius: 1000px;
    }

    .k-tt__id {
      display: grid;
      gap: 2px;
      min-width: 0;
    }

    .k-tt__name {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.35;
    }

    .k-tt__role {
      font-size: 12px;
      font-weight: 500;
      line-height: 1.4;
      color: var(--muted);
    }

    .k-tt__list .k-tt__fixture {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 14px 16px;
      text-align: left;
    }

    .k-tt__list .k-tt__fixture small {
      display: block;
    }
  }

  /* ---- after the grid ----------------------------------------------- */

  .k-tt__undated {
    margin-top: 32px;
  }

  .k-tt__undated h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }

  .k-tt__note {
    margin-top: 24px;
    font-size: 13px;
    color: var(--muted);
  }
</style>
