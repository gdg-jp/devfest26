---
import Arrow from "./Arrow.astro";
import type { ResolvedTenant } from "../../../tenants";
import { currentLanguage } from "../../../i18n/language";
import { copy } from "../_content";

/**
 * The foot of a session or speaker page. Someone who has read this far into
 * one talk is as close to registering as anyone on the site, so the page ends
 * on the one button rather than on the footer.
 */
interface Props {
  site: ResolvedTenant;
  /** Where the click is reported as having come from. */
  placement: string;
}

const { site, placement } = Astro.props;
const lang = currentLanguage();
const c = copy(lang);
const { event } = site;
const date = event.isoDate.replaceAll("-", ".");
const day = (lang === "ja" ? event.dayOfWeekEn : event.dayOfWeek).toUpperCase();
---

<section class="k-sec k-sec--panel k-closing" aria-labelledby="k-closing-h">
  <div class="k-wrap k-wrap--panel">
    <div class="k-closing__card k-dark" data-k-reveal="rise">
      <p class="k-closing__when">
        <span class="k-closing__dots" aria-hidden="true"
          ><i></i><i></i><i></i><i></i></span
        >
        <time datetime={event.isoDate}>{date} {day}</time>
        <span>{c.venueShort}</span>
      </p>
      <h2 class="k-closing__title" id="k-closing-h">
        {c.closingTitle.map((line) => <span>{line}</span>)}
      </h2>
      <div class="k-closing__end">
        <a
          class="k-btn k-btn--light k-btn--lg"
          href={site.links.register}
          target="_blank"
          rel="noopener"
          data-analytics="register_click"
          data-placement={placement}
          data-k-magnet
        >
          {c.register}
          <span class="k-btn__disc"><Arrow /></span>
        </a>
        <p class="k-closing__note">{c.closingNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .k-closing__card {
    position: relative;
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    padding: clamp(28px, 5vw, 56px) clamp(22px, 5vw, 56px);
    border: var(--k-line) solid var(--ink);
    border-radius: var(--k-r-lg);
    overflow: hidden;
  }

  .k-closing__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--k-on-dark-muted);
  }

  .k-closing__when time {
    color: var(--surface);
  }

  .k-closing__dots {
    display: inline-flex;
    gap: 5px;
  }

  .k-closing__dots i {
    width: 12px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--blue);
  }

  .k-closing__dots i:nth-child(2) {
    background: var(--red);
  }

  .k-closing__dots i:nth-child(3) {
    background: var(--yellow);
  }

  .k-closing__dots i:nth-child(4) {
    background: var(--green);
  }

  .k-closing__title {
    display: grid;
    margin: 0;
    font-family: var(--k-f-jp);
    font-weight: 700;
    font-size: clamp(26px, 5vw, 44px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .k-closing__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }

  .k-closing__note {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--k-on-dark-muted);
  }

  @media (width < 520px) {
    .k-closing__end :global(.k-btn) {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
