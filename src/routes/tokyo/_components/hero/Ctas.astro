---
import Arrow from "../Arrow.astro";
import type { ResolvedTenant } from "../../../../tenants";
import { tenantPath } from "../../../../lib/url";
import { TIMETABLE_PATH } from "../../_content";
import type { HeroFacts } from "./facts";

/**
 * The key visual's two buttons, in the page's own button: the timetable's own
 * page in the theme red, the sessions in white. Registering is the header's
 * job, which stays on screen all the way down. Side by side, then stacked
 * full width for a thumb.
 */
interface Props {
  site: ResolvedTenant;
  facts: HeroFacts;
}

const { site, facts } = Astro.props;
---

<div class="tkh-ctas">
  <a
    class="tk-btn tk-btn--lg tkh-ctas__timetable"
    href={tenantPath(site.tenant, TIMETABLE_PATH)}
    data-tk-magnet
  >
    {facts.text("timetable")}
    <span class="tk-btn__disc">
      <Arrow />
    </span>
  </a>
  <a class="tk-btn tk-btn--lg tk-btn--light" href="#sessions" data-tk-magnet>
    {facts.text("sessions")}
    <span class="tk-btn__disc">
      <Arrow class="tkh-ctas__down" />
    </span>
  </a>
</div>

<style>
  .tkh-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .tkh-ctas .tkh-ctas__timetable {
    --tk-btn-bg: var(--tk-accent);
    --tk-btn-fg: var(--tk-accent-on);
    --tk-btn-flood: var(--ink);
  }

  .tkh-ctas :global(.tkh-ctas__down) {
    rotate: 90deg;
  }

  @media (width < 560px) {
    .tkh-ctas {
      flex-direction: column;
      align-items: stretch;
      width: min(100%, 420px);
      margin-inline: auto;
    }

    /* Both buttons, so the two arrows line up at the right edge. */
    .tkh-ctas > .tk-btn {
      justify-content: space-between;
    }
  }
</style>
