---
import Org from "./Org.astro";
import Ctas from "./Ctas.astro";
import Wordmark from "../Wordmark.astro";
import Icon from "../Icon.astro";
import type { ResolvedTenant } from "../../../../tenants";
import { getProgram } from "../../../../data/program";
import { currentLanguage } from "../../../../i18n/language";
import { CATEGORIES, LANES, localized, type Lane } from "../../_content";
import { trackTone } from "../track";
import { heroFacts } from "./facts";

/**
 * Key visual C, "Split": the theme's two halves, side by side. The screen is
 * cut on a slant — Meet the Vibes on the left in its lane's pastel, Beyond the
 * Vibes on the right in its own — and the event sits on top of the cut: the
 * name, the day and the place first, so the screen says what this is before
 * it says how it is split. Under them the two halves face each other across
 * the seam, each with only its name and its categories — what the halves mean
 * is the overview's job, just below — and the buttons close it, one on each
 * side of the seam, in the same columns as the halves above them.
 *
 * The two names differ only in what is drawn under them: a hand-drawn wave
 * under Meet's (the loose, friendly half), a dimension line under Beyond's
 * (the planned one), a dot running along it. The words themselves stay plain
 * so they read at a glance.
 *
 * The margins say who each half is for and what is in it: on Meet's side a
 * sprout (for beginners) and its two categories' icons; on Beyond's a
 * summit (intermediate and up) and its two.
 *
 * On a phone the screen is tall, so the cut turns nearly level and the
 * column is read as the wide screen is: Meet up top on its pink, the event in
 * the middle with the seam running behind the card of the day and the place,
 * Beyond below on its green, then the two buttons. The names are set smaller
 * than the event's, and each half's two categories are just their icons,
 * scattered round its name — still links to their sessions. Both kinds, the
 * name, the day and the place are on the first screen.
 */
export type SplitVariant = "split" | "tape" | "giant" | "night";
export type SplitCta = "field" | "tray" | "ink";

/**
 * `variant` is how the cut is drawn, while the treatments are compared in
 * development (`Home` flips between them with `?hero=`):
 * - `split`: a hairline between the two pastels.
 * - `tape`: a black tape along the cut, the theme running along it, and the
 *   event on a white ticket laid over it.
 * - `giant`: MEET and BEYOND as huge pale letters, each in its own half.
 * - `night`: Beyond's half in ink — the day and the night, the first step
 *   and what lies past it.
 *
 * `cta` is where the buttons stand on a phone (`?cta=`): on Beyond's colour
 * as on a wide screen (`field`), on a tray of the page's own paper (`tray`),
 * or on a band of ink cut on the same slant as the seam (`ink`).
 */
interface Props {
  site: ResolvedTenant;
  variant?: SplitVariant;
  cta?: SplitCta;
}

const { site, variant = "split", cta = "field" } = Astro.props;
const titleId = variant === "split" ? "tkh-c-title" : `tkh-c-title-${variant}`;
const lang = currentLanguage();
const f = heroFacts(site, lang);

const program = await getProgram(site.tenant);
const lanes = (Object.keys(LANES) as Lane[]).map((lane) => {
  const categories = CATEGORIES.filter((c) => c.lane === lane).flatMap((c) => {
    const group = program.find(({ track }) => track.id === c.track);
    if (!group) return [];
    return [
      {
        icon: c.icon,
        id: group.track.id,
        label: group.track.data.label,
        tone: trackTone(group.track),
        linked: group.sessions.length > 0,
      },
    ];
  });
  const [head, ...rest] = LANES[lane].title.split(" ");
  return {
    lane,
    head,
    rest: rest.join(" "),
    sub: localized(LANES[lane].sub, lang),
    fill: categories[0]?.tone.pa ?? "var(--surface)",
    categories,
  };
});
const [meet, beyond] = lanes;

// The cut, in percent of the width at the top and at the foot.
const CUT = { top: 54, foot: 46 };

// Meet's underline: a hand-drawn wave, four and a half swells.
const WAVE = `M2 10 ${Array.from({ length: 9 }, (_, i) => `q13 ${i % 2 ? 9 : -9} 26 0`).join(" ")}`;

// What runs along the tape, end to end.
const TAPE = [
  "MEET THE VIBES",
  "BEYOND THE VIBES",
  `DEVFEST TOKYO ${f.year}`,
  `${f.year}.${f.month}.${f.day}`,
];
const beyondFill = variant === "night" ? "var(--ink)" : beyond.fill;
---

<section
  class:list={["tkh-c", `tkh-c--${variant}`, `tkh-c--cta-${cta}`]}
  aria-labelledby={titleId}
  style={`--tkh-c-meet:${meet.fill};--tkh-c-beyond:${beyondFill}`}
>
  <svg
    class="tkh-c__ground"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <polygon
      class="tkh-c__fill--meet"
      points={`0,0 ${CUT.top},0 ${CUT.foot},100 0,100`}
    ></polygon>
    <polygon
      class="tkh-c__fill--beyond"
      points={`${CUT.top},0 100,0 100,100 ${CUT.foot},100`}
    ></polygon>
    <line x1={CUT.top} y1="0" x2={CUT.foot} y2="100"></line>
  </svg>
  {variant === "tape" && (
    <div class="tkh-c__seam" aria-hidden="true">
      <div class="tkh-c__fill-b" />
      <div class="tkh-c__tape">
        <div class="tkh-c__band">
          {[0, 1].map(() => (
            <span class="tkh-c__run">
              {[0, 1, 2].map(() =>
                TAPE.map((t) => (
                  <>
                    {t}
                    <i>✦</i>
                  </>
                )),
              )}
            </span>
          ))}
        </div>
      </div>
    </div>
  )}
  <div class="tkh-c__lines" aria-hidden="true"></div>
  {variant === "giant" && (
    <div class="tkh-c__giant" aria-hidden="true">
      <span class="tkh-c__giant-half tkh-c__giant-half--meet">
        <span>MEET</span>
      </span>
      <span class="tkh-c__giant-half tkh-c__giant-half--beyond">
        <span>BEYOND</span>
      </span>
    </div>
  )}

  <div class="tkh-c__stickers" aria-hidden="true">
    {lanes.map(({ lane, categories }) => (
      <>
        <span
          class:list={[
            "tkh-c__sticker tkh-c__badge tkh-c__badge--level",
            `tkh-c__badge--${lane}-level`,
          ]}
          style={`--tkh-c-cat:${categories[0]?.tone.ht}`}
        >
          <Icon name={lane === "meet" ? "sprout" : "summit"} />
        </span>
        {categories.map(({ icon, tone }, i) => (
          <span
            class:list={[
              "tkh-c__sticker tkh-c__badge",
              `tkh-c__badge--${lane}-${i}`,
            ]}
            style={`--tkh-c-cat:${tone.ht}`}
          >
            <Icon name={icon} />
          </span>
        ))}
      </>
    ))}
  </div>

  <Org facts={f} />

  <header class="tkh-c__head">
    <p class="tkh-c__by">{f.text("by")}</p>
    <h1 class="tkh-c__title" id={titleId}>
      <span class="visually-hidden">{site.title}</span>
      <Wordmark label="" split />
    </h1>
    <p class="tkh-c__lead">
      {f
        .text("lead")
        .split("|")
        .map((part) => (
          <span>{part}</span>
        ))}
    </p>
    <dl class="tkh-c__facts">
      <div>
        <dt class="visually-hidden">Date</dt>
        <dd class="tkh-c__when">
          <time datetime={f.startsAt}>
            <span class="tkh-c__ymd">
              {f.year}.{f.month}.{f.day}
            </span>
            <span class="tkh-c__dow">({f.dow})</span>
            <span class="tkh-c__hours">
              {f.start}–{f.end}
            </span>
          </time>
        </dd>
      </div>
      <div>
        <dt class="visually-hidden">Venue</dt>
        <dd class="tkh-c__where">
          <span class="tkh-c__walk">
            <Icon name="train" />
            {f.station}
            <b>{f.walk}</b>
          </span>
          <span class="tkh-c__venue">{f.venue}</span>
        </dd>
      </div>
    </dl>
  </header>

  <div class="tkh-c__lanes">
    {lanes.map(({ lane, head, rest, sub, categories }) => (
      <div class:list={["tkh-c__lane", `tkh-c__lane--${lane}`]}>
        <p class:list={["tkh-c__name", `tkh-c__name--${lane}`]}>
          <span class="visually-hidden">{`${head} ${rest}`}</span>
          {lane === "meet" ? (
            <span class="tkh-c__set" aria-hidden="true">
              <span>{head}</span>
              <span class="tkh-c__rest">
                {rest}
                <svg
                  class="tkh-c__wave"
                  viewBox="0 0 240 20"
                  preserveAspectRatio="none"
                >
                  <path d={WAVE} pathLength="1" />
                </svg>
              </span>
            </span>
          ) : (
            <span class="tkh-c__set" aria-hidden="true">
              <span>{head}</span>
              <span class="tkh-c__rest">{rest}</span>
              <span class="tkh-c__dim" />
            </span>
          )}
        </p>
        <p class="tkh-c__sub">{sub}</p>
        <span
          class="tkh-c__lvl"
          aria-hidden="true"
          style={`--tkh-c-cat:${categories[0]?.tone.ht}`}
        >
          <Icon name={lane === "meet" ? "sprout" : "summit"} />
        </span>
        <ul class="tkh-c__cats">
          {categories.map(({ icon, id, label, tone, linked }) => {
            const Tag = linked ? "a" : "span";
            return (
              <li>
                <Tag
                  class="tkh-c__cat"
                  href={linked ? `#tk-sessions-${id}` : undefined}
                  style={`--tkh-c-cat:${tone.ht}`}
                >
                  <span class="tkh-c__icon">
                    <Icon name={icon} />
                  </span>
                  <span class="tkh-c__label">{label}</span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>

  <div class="tkh-c__ctas">
    <Ctas site={site} facts={f} />
  </div>
</section>

<style>
  .tkh-c {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    --tkh-c-gap: clamp(72px, 11vw, 168px);
    gap: clamp(32px, 6vh, 64px);
    min-height: 100svh;
    padding: clamp(84px, 11vh, 112px) var(--tk-gutter)
      calc(clamp(24px, 4vh, 44px) + env(safe-area-inset-bottom));
    overflow: clip;
  }

  /* ---- the ground: two pastels, cut on a slant ---------------------- */

  .tkh-c__ground,
  .tkh-c__lines,
  .tkh-c__stickers {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tkh-c__fill--meet {
    fill: var(--tkh-c-meet);
  }

  .tkh-c__fill--beyond {
    fill: var(--tkh-c-beyond);
  }

  .tkh-c__ground line {
    stroke: var(--ink);
    stroke-width: var(--tk-line);
    vector-effect: non-scaling-stroke;
  }

  /* The page's graph paper, over both pastels. */
  .tkh-c__lines {
    --tkh-c-grid: color-mix(in srgb, var(--ink) 8%, transparent);
    background:
      linear-gradient(var(--tkh-c-grid) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, var(--tkh-c-grid) 1px, transparent 1px) 0 0 / 32px
        32px;
  }

  /* ---- the margins: who each half is for -----------------------------
     Meet's on the left, Beyond's on the right, clear of the words. */

  .tkh-c__sticker {
    position: absolute;
  }

  .tkh-c__badge {
    display: grid;
    place-items: center;
    width: clamp(48px, 4.6vw, 72px);
    aspect-ratio: 1;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--tkh-c-cat);
  }

  .tkh-c__badge :global(svg) {
    width: 48%;
    height: 48%;
  }

  /* The level's mark, a size up and in its half's colour, leads each
     margin. */
  .tkh-c__badge--level {
    width: clamp(60px, 5.8vw, 92px);
  }

  /* Three down each margin at even steps — top, middle, foot — swinging
     in and out so they do not stand in a column. */
  .tkh-c__badge--meet-level {
    top: 15%;
    left: 6%;
    rotate: -8deg;
  }

  /* In from the edge, but never as far as the card of the day and place. */
  .tkh-c__badge--meet-0 {
    top: 43%;
    left: clamp(2%, calc(50% - 420px), 12%);
    rotate: 10deg;
  }

  .tkh-c__badge--meet-1 {
    top: 71%;
    left: 5%;
    rotate: -6deg;
  }

  .tkh-c__badge--beyond-level {
    top: 15%;
    right: 6%;
    rotate: 8deg;
  }

  .tkh-c__badge--beyond-0 {
    top: 43%;
    right: clamp(2%, calc(50% - 420px), 12%);
    rotate: -10deg;
  }

  .tkh-c__badge--beyond-1 {
    top: 71%;
    right: 5%;
    rotate: 6deg;
  }

  /* ---- the event, first --------------------------------------------- */

  .tkh-c__head {
    display: grid;
    justify-items: center;
    gap: clamp(8px, 1.4vh, 14px);
    text-align: center;
  }

  .tkh-c__by {
    margin: 0;
    font: 500 clamp(14px, 1.5vw, 19px) / 1 var(--tk-f-display);
  }

  .tkh-c__title {
    width: clamp(280px, 46vw, 680px);
    margin: 0;
    font-size: inherit;
  }

  /* When and where on one white strip, laid across the seam. */
  .tkh-c__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 22px;
    margin: 4px 0 0;
    padding: 10px 26px;
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-lg);
    background: var(--surface);
  }

  .tkh-c__facts dd {
    margin: 0;
  }

  /* What the day is, in GDG Tokyo's words, between the name and the card.
     Each half of the line stays whole when it has to break. */
  .tkh-c__lead {
    margin: 0;
    font: 700 clamp(15px, 1.45vw, 20px) / 1.5 var(--tk-f-jp);
    letter-spacing: 0.02em;
  }

  .tkh-c__lead span {
    display: inline-block;
  }

  /* What is in each half, under its name. */
  .tkh-c__sub {
    margin: 0;
    font: 700 clamp(12px, 1.05vw, 15px) / 1.4 var(--tk-f-jp);
  }

  .tkh-c__when time {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--tk-f-display);
    font-weight: 700;
    white-space: nowrap;
  }

  .tkh-c__ymd {
    font-size: clamp(26px, 2.8vw, 38px);
    letter-spacing: -0.03em;
  }

  .tkh-c__dow {
    margin-left: -4px;
    font-family: var(--tk-f-jp);
    font-size: 15px;
  }

  .tkh-c__hours {
    font-size: clamp(16px, 1.5vw, 20px);
  }

  .tkh-c__where {
    display: grid;
    justify-items: start;
    padding-left: 22px;
    border-left: var(--tk-line) solid var(--ink);
    text-align: left;
  }

  .tkh-c__walk {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 700 14px/1.4 var(--tk-f-jp);
  }

  .tkh-c__walk :global(svg) {
    width: 17px;
    height: 17px;
  }

  .tkh-c__walk b {
    font-size: 1.15em;
    background: linear-gradient(
      transparent 58%,
      var(--ht-yellow) 58% 92%,
      transparent 92%
    );
  }

  .tkh-c__venue {
    font: 500 12px/1.4 var(--tk-f-jp);
  }

  /* ---- the two halves, facing across the seam ----------------------- */

  .tkh-c__lanes {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--tkh-c-gap);
    width: min(100%, 1080px);
    margin-inline: auto;
  }

  .tkh-c__lane {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.2vh, 22px);
  }

  .tkh-c__lane--meet {
    align-items: flex-end;
    text-align: right;
  }

  .tkh-c__lane--beyond {
    align-items: flex-start;
  }

  .tkh-c__name {
    display: grid;
    margin: 0;
    font-family: var(--tk-f-display);
    font-weight: 700;
    font-size: clamp(34px, 4.6vw, 76px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  /* A little air between the lines, so Beyond's y clears the Vibes under
     it. */
  .tkh-c__set {
    position: relative;
    display: grid;
    row-gap: 0.16em;
  }

  .tkh-c__rest {
    position: relative;
    color: var(--surface);
    -webkit-text-stroke: var(--tk-line) var(--ink);
  }

  /* ---- Meet: a hand-drawn wave under the Vibes ---------------------- */

  .tkh-c__wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2em;
    width: 100%;
    height: 0.18em;
    overflow: visible;
  }

  .tkh-c__wave path {
    fill: none;
    stroke: var(--tk-accent);
    stroke-width: 4px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* ---- Beyond: a dimension line under the Vibes -------------------- */

  /* A dimension line: ticks at both ends, a dot travelling along. */
  .tkh-c__dim {
    position: relative;
    height: 0.18em;
    border-inline: var(--tk-line) solid var(--ink);
  }

  .tkh-c__dim::before {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: var(--tk-line);
    margin-top: calc(var(--tk-line) / -2);
    background: var(--ink);
  }

  .tkh-c__dim::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.12em;
    aspect-ratio: 1;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--ht-green);
    translate: -50% -50%;
  }

  /* The level mark beside the name is the phone's; the margins carry it on
     a wide screen. */
  .tkh-c__lvl {
    display: none;
  }

  .tkh-c__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tkh-c__lane--meet .tkh-c__cats {
    justify-content: flex-end;
  }

  .tkh-c__cat {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px 4px 4px;
    border: var(--tk-line) solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 700 clamp(12px, 1.1vw, 14px) / 1.2 var(--tk-f-jp);
    text-decoration: none;
    transition: translate 0.3s var(--tk-ease-back);
  }

  a.tkh-c__cat:hover {
    translate: 0 -3px;
  }

  .tkh-c__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    aspect-ratio: 1;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--tkh-c-cat);
  }

  .tkh-c__icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  /* ---- the buttons: one in each half -------------------------------
     The same two columns and the same gap as the halves, so each button
     stands on its own colour, the seam running between them. */

  .tkh-c__ctas :global(.tkh-ctas) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--tkh-c-gap);
    width: min(100%, 1080px);
    margin-inline: auto;
  }

  .tkh-c__ctas :global(.tkh-ctas > :first-child) {
    justify-self: end;
  }

  .tkh-c__ctas :global(.tkh-ctas > :last-child) {
    justify-self: start;
  }

  /* ---- entrance ----------------------------------------------------- */

  @media (prefers-reduced-motion: no-preference) {
    /* Backwards, not both: once it has played the head must not stay a
       stacking context, or on a phone Beyond's green, hung from the card,
       would paint over the giant BEYOND. */
    .tkh-c__head {
      animation: tkh-c-pop 0.8s var(--tk-ease-back) backwards;
    }

    .tkh-c__lane--meet {
      --tkh-c-from: -40px;
      animation: tkh-c-from 0.9s var(--tk-ease) 0.2s both;
    }

    .tkh-c__lane--beyond {
      --tkh-c-from: 40px;
      animation: tkh-c-from 0.9s var(--tk-ease) 0.32s both;
    }

    .tkh-c__sticker {
      animation: tkh-c-float 5s ease-in-out infinite alternate;
    }

    .tkh-c__wave path {
      stroke-dasharray: 1;
      animation: tkh-c-draw 1.2s var(--tk-ease) 0.6s both;
    }

    .tkh-c__dim::after {
      animation: tkh-c-run 3.2s var(--tk-ease-io) infinite alternate;
    }

    .tkh-c__sticker:nth-child(2n) {
      animation-delay: -2.5s;
    }
  }

  @keyframes tkh-c-pop {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  @keyframes tkh-c-from {
    from {
      opacity: 0;
      translate: var(--tkh-c-from) 0;
    }
  }

  @keyframes tkh-c-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes tkh-c-run {
    to {
      left: 100%;
    }
  }

  @keyframes tkh-c-float {
    to {
      translate: 0 -12px;
    }
  }

  /* ---- phone: Meet, the event across the seam, Beyond ----------------- */

  @media (width < 760px) {
    .tkh-c {
      --tkh-c-cut: 44px;
      --tkh-c-grid: color-mix(in srgb, var(--ink) 8%, transparent);
      --tkh-c-lines:
        linear-gradient(var(--tkh-c-grid) 1px, transparent 1px) 0 0 / 32px 32px,
        linear-gradient(90deg, var(--tkh-c-grid) 1px, transparent 1px) 0 0 /
          32px 32px;
      justify-content: space-between;
      gap: 14px;
      padding-top: 76px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom));
      /* Meet's pink from the top; the event paints Beyond's green under the
