---
import Icon from "./Icon.astro";
import Level from "./Level.astro";
import type { ResolvedTenant } from "../../../tenants";
import { getProgram } from "../../../data/program";
import { currentLanguage } from "../../../i18n/language";
import {
  copy,
  LANES,
  localized,
  REGISTER,
  THEME,
  type Lane,
} from "../_content";
import { laneTone } from "./track";

/**
 * The two places to sign up, side by side: one card per half of the theme,
 * in its pastel, saying who it is for and where it goes (`REGISTER` in
 * `_content.ts`). Inside `RegisterChoice`, which the page's register buttons
 * open, and at the foot of the session and speaker pages.
 */
interface Props {
  site: ResolvedTenant;
  /** Where the click is reported as having come from. */
  placement: string;
}

const { site, placement } = Astro.props;
const lang = currentLanguage();
const c = copy(lang);

const program = await getProgram(site.tenant);
const MARK: Record<Lane, "sprout" | "summit"> = {
  meet: "sprout",
  beyond: "summit",
};
const options = (Object.keys(LANES) as Lane[]).map((lane) => {
  const tone = laneTone(program, lane);
  return {
    lane,
    title: LANES[lane].title,
    lead: localized(THEME[lane].lead, lang),
    fill: tone?.pa ?? "var(--surface)",
    ht: tone?.ht ?? "var(--ht-yellow)",
    mark: MARK[lane],
    ...REGISTER[lane],
  };
});
---

<ul class="tk-reg">
  {options.map(({ lane, title, lead, fill, ht, mark, href, via, audience }) => (
    <li>
      <a
        class="tk-reg__opt"
        href={href}
        target="_blank"
        rel="noopener"
        style={`--tk-reg-fill:${fill};--tk-reg-ht:${ht}`}
        data-analytics="register_click"
        data-placement={placement}
        data-audience={lane}
      >
        <span class="tk-reg__mark" aria-hidden="true">
          <Icon name={mark} />
        </span>
        <span class="tk-reg__audience">{localized(audience, lang)}</span>
        <span class="tk-reg__title">{title}</span>
        <Level lane={lane} stars={false} />
        <span class="tk-reg__lead">{lead}</span>
        <span class="tk-reg__via">
          {c.registerVia(via)}
          <span class="tk-reg__disc">
            <Icon name="external" />
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .tk-reg {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tk-reg > li {
    display: grid;
  }

  .tk-reg__opt {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    justify-items: start;
    gap: 8px;
    padding: 18px 18px 16px;
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-md);
    background: var(--tk-reg-fill);
    color: var(--ink);
    text-decoration: none;
    transition:
      translate 0.3s var(--tk-ease),
      box-shadow 0.3s var(--tk-ease);
  }

  .tk-reg__opt:hover {
    translate: 0 -3px;
    box-shadow: 0 5px 0 var(--ink);
  }

  .tk-reg__opt:focus-visible {
    outline: 3px solid var(--tk-accent-deep);
    outline-offset: 4px;
  }

  .tk-reg__mark {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 40px;
    aspect-ratio: 1;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--tk-reg-ht);
  }

  .tk-reg__mark :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* Who it is for is the question being asked, so it is the loudest line. */
  .tk-reg__audience {
    padding-right: 48px;
    font: 800 clamp(18px, 2vw, 21px) / 1.3 var(--tk-f-jp);
  }

  .tk-reg__title {
    font-family: var(--tk-f-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .tk-reg__lead {
    font-size: 13px;
    line-height: 1.6;
  }

  .tk-reg__via {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    justify-self: stretch;
    margin-top: 4px;
    padding: 6px 6px 6px 16px;
    border: var(--tk-line) solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--surface);
    font: 700 14px/1.3 var(--tk-f-jp);
  }

  .tk-reg__disc {
    display: grid;
    flex: none;
    place-items: center;
    width: 30px;
    aspect-ratio: 1;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--tk-reg-ht);
    color: var(--ink);
    transition: rotate 0.4s var(--tk-ease-back);
  }

  .tk-reg__disc :global(svg) {
    width: 14px;
    height: 14px;
  }

  .tk-reg__opt:hover .tk-reg__disc {
    rotate: -12deg;
  }

  /* Stacked on a phone, and a little tighter, so both fit on one screen. */
  @media (width < 560px) {
    .tk-reg {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .tk-reg__opt {
      gap: 6px;
      padding: 14px 14px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-reg__opt,
    .tk-reg__disc {
      transition: none;
    }
  }
</style>
