---
import RegisterOptions from "./RegisterOptions.astro";
import Icon from "./Icon.astro";
import type { ResolvedTenant } from "../../../tenants";
import { currentLanguage } from "../../../i18n/language";
import { messages } from "../../../i18n";
import { AFTER_PARTY_URL, localized, OVERVIEW } from "../_content";

/**
 * The foot of a session or speaker page. Someone who has read this far into
 * one talk is as close to registering as anyone on the site, so the page ends
 * on the two places to sign up — one per half of the theme — rather than on
 * the footer.
 */
interface Props {
  site: ResolvedTenant;
  /** Where the click is reported as having come from. */
  placement: string;
}

const { site, placement } = Astro.props;
const lang = currentLanguage();
const t = messages(lang);
const { event } = site;
const date = event.isoDate.replaceAll("-", ".");
const day = (lang === "ja" ? event.dayOfWeekEn : event.dayOfWeek).toUpperCase();
---

<section class="tk-sec tk-sec--panel tk-closing" aria-labelledby="tk-closing-h">
  <div class="tk-wrap tk-wrap--panel">
    <div class="tk-closing__card tk-dark" data-tk-reveal="rise">
      <p class="tk-closing__when">
        <span class="tk-closing__dots" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <i></i>
        </span>
        <time datetime={event.isoDate}>
          {date} {day}
        </time>
        <span>{event.venue.name}</span>
      </p>
      <h2 class="tk-closing__title" id="tk-closing-h">
        {/* The old register section's words; nothing here is new copy. */}
        <span>{t.register.headingLine1}</span>
        <span>{t.register.headingLine2(event.monthDay, event.venue.city)}</span>
      </h2>
      <div class="tk-closing__end">
        <RegisterOptions site={site} placement={placement} />
        <p class="tk-closing__note">
          <span>
            {localized(OVERVIEW.fee, lang)} ※ {localized(OVERVIEW.feeNote, lang)}
          </span>
          <a
            class="tk-closing__party"
            href={AFTER_PARTY_URL}
            target="_blank"
            rel="noopener"
          >
            {localized(OVERVIEW.afterParty, lang)}
            <Icon name="external" />
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .tk-closing__card {
    position: relative;
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    padding: clamp(28px, 5vw, 56px) clamp(22px, 5vw, 56px);
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-lg);
    overflow: hidden;
  }

  .tk-closing__when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--tk-on-dark-muted);
  }

  .tk-closing__when time {
    color: var(--surface);
  }

  .tk-closing__dots {
    display: inline-flex;
    gap: 5px;
  }

  .tk-closing__dots i {
    width: 12px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tk-accent);
  }

  .tk-closing__dots i:nth-child(2) {
    background: var(--yellow);
  }

  .tk-closing__dots i:nth-child(3) {
    background: var(--green);
  }

  .tk-closing__title {
    display: grid;
    margin: 0;
    font-family: var(--tk-f-jp);
    font-weight: 700;
    font-size: clamp(26px, 5vw, 44px);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .tk-closing__end {
    display: grid;
    gap: 14px;
  }

  .tk-closing__note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 10px;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--tk-on-dark-muted);
  }

  /* The after-party's sign-up: a small aside to its note, not a button. */
  .tk-closing__party {
    font-size: 13px;
    color: var(--surface);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    text-decoration-color: var(--tk-on-dark-muted);
    transition: text-decoration-color 0.2s;
  }

  .tk-closing__party:hover {
    text-decoration-color: var(--surface);
  }

  .tk-closing__party:focus-visible {
    outline: 3px solid var(--ht-yellow);
    outline-offset: 2px;
  }

  .tk-closing__party :global(svg) {
    width: 12px;
    margin-left: 3px;
    vertical-align: -1px;
  }
</style>
