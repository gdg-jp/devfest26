---
import Shell from "../_layout/Shell.astro";
import HeroSplit from "./hero/HeroSplit.astro";
import Featured from "./Featured.astro";
import Theme from "./Theme.astro";
import Overview from "./Overview.astro";
import News from "./News.astro";
import PreEvent from "./PreEvent.astro";
import Sessions from "./Sessions.astro";
import Speakers from "./Speakers.astro";
import Sponsors from "./Sponsors.astro";
import Faq from "./Faq.astro";
import type { ResolvedTenant } from "../../../tenants";
import { homeData } from "../_data";

/**
 * Tokyo's home page, laid out as Kansai's: the key visual, the headliners,
 * then the programme from the top down — by theme rather than by time, since
 * Tokyo's day is not settled yet (`Sessions`, where Kansai has its timetable). The register button stays in the header,
 * which pins to the top of the screen, all the way down.
 *
 * The key visual is `hero/HeroSplit.astro` (candidate C), drawn on the same
 * graph paper as the rest of the page. The other three candidates, and the
 * switch that flipped between them in development, are kept out of the build
 * in `design/tokyo-hero/`.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const { featured, speakers } = await homeData(site.tenant);
---

<Shell site={site} docked>
  <div class="tk-hero" slot="hero" data-tk-hero>
    <HeroSplit site={site} />
  </div>
  <Theme site={site} />
  <Overview site={site} />
  <Featured featured={featured} />
  <News />
  <PreEvent tenant={site.tenant} />
  <Sessions site={site} />
  <Speakers speakers={speakers} />
  <Sponsors />
  <Faq site={site} />
</Shell>

<style>
  .tk-hero {
    position: relative;
  }
</style>
