---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { isRemotePhoto } from "../../../lib/photo";
import { speakerPhotoUrl } from "../../../lib/sanity/image";

/**
 * A speaker's photo at whatever size a section wants it, from either source:
 * a file beside the Markdown (resized here) or a CDN URL (already cropped).
 * With no photo at all, the initial on a brand colour — never an empty frame.
 */
interface Props {
  speaker: CollectionEntry<"speakers">;
  /** Largest drawn width in CSS px. The file is fetched at twice that. */
  size: number;
  class?: string;
  eager?: boolean;
  /** Fill colour behind a missing photo. */
  tone?: string;
}

const {
  speaker,
  size,
  class: className,
  eager = false,
  tone = "var(--ht-yellow)",
} = Astro.props;
const { photo, initial, name } = speaker.data;
const loading = eager ? "eager" : "lazy";
const px = Math.round(size * 2);

// A Sanity photo's `src` is cut at the small avatars' size, which a large
// frame blows up into a blur. Cut it again, at this frame's size, from the
// image it came from — the crop still follows the organiser's hotspot.
const remote =
  photo && isRemotePhoto(photo)
    ? photo.source
      ? { src: speakerPhotoUrl(photo.source, px), width: px, height: px }
      : photo
    : undefined;
---

{photo ? (
  remote ? (
    <img
      class={className}
      src={remote.src}
      alt=""
      width={remote.width}
      height={remote.height}
      loading={loading}
      decoding="async"
    />
  ) : isRemotePhoto(photo) ? null : (
    <Image
      class={className}
      src={photo}
      alt=""
      width={Math.min(px, photo.width)}
      height={Math.round(
        (Math.min(px, photo.width) * photo.height) / photo.width,
      )}
      loading={loading}
      decoding="async"
    />
  )
) : (
  <span
    class:list={[className, "tk-portrait-fallback"]}
    style={`background:${tone}`}
    aria-hidden="true"
  >
    {initial ?? name.replace(/\s*氏$/, "").slice(0, 1)}
  </span>
)}

<style>
  .tk-portrait-fallback {
    display: grid;
    place-items: center;
    font-family: var(--tk-f-display);
    font-weight: 700;
    color: var(--ink);
    font-size: 2em;
  }
</style>
