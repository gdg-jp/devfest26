---
/**
 * The card every programme section sits in: a folder with its title on a
 * coloured tab tucked into a notch at the top left, and a pair of GDG
 * stickers in the tab's colour on the shelf beside it.
 *
 * The card's outline is one SVG path drawn by `_scripts/panel.ts` round
 * whatever size the card and its tab end up; the tab sits in the notch,
 * its border doubling as the notch's edge. Without the script the body falls back to a plain
 * bordered box.
 */
import { STICKERS, type StickerName } from "./stickers";

interface Props {
  title: string;
  id: string;
  tone: string;
  stickers: StickerName[];
  /** A Japanese title is set in the Japanese face. */
  ja?: boolean;
  /** The tab's element. A page whose `h1` sits inside the panel makes it a `p`. */
  tag?: "h2" | "p";
  class?: string;
}

const {
  title,
  id,
  tone,
  stickers,
  ja = false,
  tag = "h2",
  class: className,
} = Astro.props;
const Tab = tag;
---

<div
  class:list={["tk-panel", className]}
  style={`--tk-tone:${tone}`}
  data-tk-folder
>
  <svg class="tk-panel__shape" aria-hidden="true" data-tk-folder-shape>
    <path></path>
  </svg>

  <Tab
    class:list={["tk-panel__title", { "tk-panel__title--ja": ja }]}
    id={id}
    data-tk-folder-tab
    data-tk-split
  >
    {title}
  </Tab>

  <div class="tk-panel__shelf" aria-hidden="true">
    {
      stickers.map((name) => {
        const s = STICKERS[name];
        return (
          <svg
            class="tk-panel__sticker"
            viewBox={`0 0 ${s.width} ${s.height}`}
            style={`width:calc(${s.width} * var(--tk-sticker-u))`}
          >
            <g transform={s.transform} set:html={s.shapes} />
          </svg>
        );
      })
    }
  </div>

  <div class="tk-panel__body">
    <slot />
  </div>
</div>

<style>
  .tk-panel {
    --tk-tab-h: clamp(52px, 5.6vw, 64px);
    --tk-panel-r: var(--tk-r-lg);
    --tk-panel-pad: clamp(20px, 3.6vw, 44px);
    --tk-sticker-u: 0.12px;
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .tk-panel__shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .tk-panel__shape path {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: var(--tk-line);
    stroke-linejoin: round;
  }

  .tk-panel > :not(.tk-panel__shape) {
    position: relative;
  }

  .tk-panel__title {
    display: flex;
    align-items: center;
    height: var(--tk-tab-h);
    margin: 0;
    padding-inline: clamp(24px, 3.2vw, 40px);
    border: var(--tk-line) solid var(--ink);
    border-radius: 999px;
    background: var(--tk-tone);
    color: var(--ink);
    font-family: var(--tk-f-display);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .tk-panel__title--ja {
    font-family: var(--tk-f-jp);
    font-size: clamp(18px, 2.2vw, 24px);
    letter-spacing: 0;
  }

  .tk-panel__shelf {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(10px, 1.6vw, 18px);
    min-width: 0;
    padding-right: clamp(16px, 2.4vw, 28px);
    overflow: hidden;
  }

  .tk-panel__sticker {
    flex: none;
    height: auto;
    overflow: visible;
    fill: var(--tk-tone);
    stroke: var(--ink);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .tk-panel__body {
    grid-column: 1 / -1;
    min-width: 0;
    padding: clamp(4px, 1.2vw, 12px) var(--tk-panel-pad)
      clamp(20px, 3.6vw, 40px);
    color: var(--ink);
  }

  .tk-panel:not(.is-drawn) .tk-panel__body {
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-panel-r);
    background: var(--surface);
  }

  @media (width < 520px) {
    .tk-panel {
      --tk-panel-r: var(--tk-r-md);
      --tk-sticker-u: 0.085px;
    }
  }
</style>
