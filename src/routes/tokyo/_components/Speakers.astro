---
import Portrait from "./Portrait.astro";
import Panel from "./Panel.astro";
import { speakerHref, type SpeakerProgram } from "../../../data/program";

/** Everyone on the programme, each one tap from their page. */
interface Props {
  speakers: SpeakerProgram[];
}

const { speakers } = Astro.props;

const bare = (name: string) => name.replace(/\s*氏$/, "");
const cycle = ["var(--tk-accent)", "var(--yellow)", "var(--green)"];
---

<section
  class="tk-sec tk-sec--panel tk-speakers"
  id="speakers"
  aria-labelledby="tk-speakers-h"
>
  <div class="tk-wrap tk-wrap--panel">
    <Panel
      title="Speakers"
      id="tk-speakers-h"
      tone="var(--ht-yellow)"
      stickers={["quoteOpen", "quoteClose"]}
    >
      <ul class="tk-grid" data-tk-stagger>
        {
          speakers.map((s, i) => (
            <li data-tk-reveal="pop">
              <a class="tk-grid__item" href={speakerHref(s.speaker)}>
                <span
                  class="tk-grid__ring"
                  style={`--ring:${cycle[i % cycle.length]}`}
                >
                  <Portrait
                    speaker={s.speaker}
                    size={96}
                    class="tk-grid__img"
                    tone={cycle[i % cycle.length]}
                  />
                </span>
                <span class="tk-grid__name">{bare(s.speaker.data.name)}</span>
                <span class="tk-grid__role">{s.speaker.data.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Panel>
  </div>
</section>

<style>
  .tk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: 32px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tk-grid__item {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 4px;
    color: var(--ink);
    text-decoration: none;
  }

  .tk-grid__ring {
    display: block;
    width: 100px;
    aspect-ratio: 1;
    margin-bottom: 10px;
    padding: 4px;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--ring);
    transition: transform 0.5s var(--tk-ease-back);
  }

  .tk-grid__ring :global(.tk-grid__img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: var(--tk-line) solid var(--ink);
    object-fit: cover;
    background: var(--surface);
    font-size: 30px;
  }

  .tk-grid__item:hover .tk-grid__ring,
  .tk-grid__item:focus-visible .tk-grid__ring {
    transform: translateY(-6px) rotate(-6deg) scale(1.06);
  }

  .tk-grid__name {
    font-family: var(--tk-f-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.4;
  }

  .tk-grid__role {
    font-size: 12px;
    line-height: 1.55;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (width < 520px) {
    .tk-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 8px;
    }

    .tk-grid__ring {
      width: 80px;
    }

    .tk-grid__name {
      font-size: 13.5px;
    }

    .tk-grid__role {
      font-size: 11px;
    }
  }
</style>
