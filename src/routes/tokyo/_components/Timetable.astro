---
import Panel from "./Panel.astro";
import Level from "./Level.astro";
import TimetableCell from "./TimetableCell.astro";
import type { ResolvedTenant } from "../../../tenants";
import { currentLanguage } from "../../../i18n/language";
import {
  CATEGORIES,
  copy,
  localized,
  timetableTrackId,
  TRACK_CODES,
} from "../_content";
import { tokyoTimetable, type TimetableSlot } from "../_timetable";
import { trackTone } from "./track";

/**
 * The day at a glance, as GDG Tokyo's timetable on connpass draws it: the
 * four tracks side by side, the opening, keynotes and closing across all of
 * them, and the demo floor in a strip on the right (`_timetable.ts`).
 *
 * Wide screens get the grid. A phone, too narrow for four columns, reads it a
 * track at a time: each track has a theme and runs through the day as one
 * story, so a tab per track shows that track's sessions top to bottom, with
 * what everyone attends (the keynotes, the closing) in its place between them.
 * Without the script every track is listed, one after another.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const lang = currentLanguage();
const c = copy(lang);

const table = await tokyoTimetable(site.tenant);

/** The track's colours, for a slot that sits in one. */
const toneOf = (slot: TimetableSlot) => {
  if (slot.span === "track" && slot.session) {
    const tone = trackTone(slot.session.track);
    return `--fill:${tone.pa};--trk:${tone.solid};--trk-ink:${tone.ink}`;
  }
  if (slot.day?.accent) return "--fill:var(--ht-yellow)";
  return "";
};

/**
 * Phone: each track's own day — its sessions and what runs across every
 * track, in time order. The demo floor runs beside all of them all day, so it
 * is said once above the lists rather than in every one.
 */
const lanes = (table?.tracks ?? []).map((track, column) => ({
  track,
  tone: trackTone(track),
  lane: CATEGORIES.find((category) => category.track === track.id)?.lane,
  steps: (table?.slots ?? [])
    .filter(
      (slot) =>
        slot.span === "all" ||
        (slot.span === "track" && slot.column === column),
    )
    .sort((x, y) => x.start.localeCompare(y.start)),
}));
const sides = (table?.slots ?? []).filter((slot) => slot.span === "side");

/** A time in the gutter wherever something in the columns starts. */
const ticks = (table?.lines ?? []).filter(({ time }) =>
  table?.slots.some((slot) => slot.span !== "side" && slot.start === time),
);

const columnOf = (slot: TimetableSlot, tracks: number) =>
  slot.span === "track"
    ? `${(slot.column ?? 0) + 2}`
    : slot.span === "all"
      ? `2/${tracks + 2}`
      : `${tracks + 2}`;
---

{table && (
  <section
    class="tk-sec tk-sec--panel tk-tt"
    id="timetable"
    aria-labelledby="tk-tt-h"
  >
    <div class="tk-wrap tk-wrap--panel tk-tt__stack">
      <Panel
        title={c.timetableHeading}
        id="tk-tt-h"
        tone="var(--ht-green)"
        stickers={["colon", "equals"]}
        ja={lang === "ja"}
      >
        <p class="tk-tt__date">{c.timetableDate}</p>
        <p class="tk-tt__lead">{c.timetableLead}</p>

        {/* ---- wide: the whole grid ------------------------------------ */}
        <div
          class="tk-tt__grid"
          style={`--tracks:${table.tracks.length};grid-template-rows:${table.rows.join(" ")}`}
        >
          {table.tracks.map((track, i) => {
            const tone = trackTone(track);
            return (
              <div
                class="tk-tt__head"
                id={timetableTrackId(track.id)}
                style={`grid-row:${table.headRow};grid-column:${i + 2};--trk:${tone.solid};--trk-ink:${tone.ink}`}
              >
                <small>{TRACK_CODES[track.id]?.name}</small>
                <b>{track.data.label}</b>
              </div>
            );
          })}

          {ticks.map(({ time, line }) => (
            <time class="tk-tt__tick" style={`grid-row:${line}`}>
              {time}
            </time>
          ))}

          {table.slots.map((slot) => (
            <div
              class="tk-tt__cell"
              style={`grid-row:${slot.rowStart}/${slot.rowEnd};grid-column:${columnOf(slot, table.tracks.length)};${toneOf(slot)}`}
            >
              <TimetableCell item={slot} />
            </div>
          ))}
        </div>

        {/* ---- phone: a track at a time -------------------------------- */}
        <div
          class="tk-tt__phone"
          style={`--tracks:${lanes.length}`}
          data-tk-tt-tabs
        >
          <div
            class="tk-tt__tabs"
            role="tablist"
            aria-label={c.timetableTracks}
            hidden
          >
            {lanes.map(({ track, tone }, i) => (
              <button
                type="button"
                class="tk-tt__tab"
                role="tab"
                id={`tk-tt-tab-${track.id}`}
                aria-controls={`tk-tt-lane-${track.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-track={track.id}
                style={`--trk:${tone.solid};--trk-pa:${tone.pa}`}
              >
                <small>{TRACK_CODES[track.id]?.name}</small>
                <b>{track.data.label}</b>
              </button>
            ))}
          </div>

          {sides.map((slot) => (
            <p class="tk-tt__side">
              <span class="tk-tt__side-tag">{c.timetableAllDay}</span>
              <b>{slot.day && localized(slot.day.title, lang)}</b>
              <time>
                {slot.start} – {slot.end}
              </time>
            </p>
          ))}

          {lanes.map(({ track, tone, lane, steps }) => (
            <section
              class="tk-tt__lane"
              id={`tk-tt-lane-${track.id}`}
              aria-labelledby={`tk-tt-lane-h-${track.id}`}
              data-track={track.id}
              style={`--trk:${tone.solid};--trk-ink:${tone.ink};--trk-pa:${tone.pa}`}
            >
              <header class="tk-tt__lane-head">
                <span class="tk-tt__lane-code">
                  {TRACK_CODES[track.id]?.name}
                </span>
                <h3 class="tk-tt__lane-title" id={`tk-tt-lane-h-${track.id}`}>
                  {track.data.label}
                </h3>
                {track.data.sub && (
                  <p class="tk-tt__lane-sub">{track.data.sub}</p>
                )}
                {lane && <Level lane={lane} />}
              </header>
              <ol class="tk-tt__flow">
                {steps.map((slot) => (
                  <li
                    class:list={[
                      "tk-tt__step",
                      slot.span === "track" ? "is-own" : "is-all",
                    ]}
                    style={toneOf(slot)}
                  >
                    <time class="tk-tt__step-time">{slot.start}</time>
                    <div class="tk-tt__step-body">
                      {slot.span === "all" && (
                        <span class="tk-tt__step-all">
                          {c.timetableAllTracks}
                        </span>
                      )}
                      <TimetableCell item={slot} phone />
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </Panel>
      <p class="tk-tt__note">{c.timetableNote}</p>
    </div>
  </section>
)}

<script>
  /*
    The phone's tabs, one per track. Every track's list is on the page; the
    script shows one at a time, and without it they stay one after another.

    A track's anchor (`#tk-tt-<id>`, its heading in the wide grid) opens its
    tab, so a link to a track lands on it on a phone too. Picking a tab writes
    the anchor back, so a shared link opens on the same track.
  */
  const PREFIX = "tk-tt-";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-tk-tt-tabs]",
  )) {
    const tabList = root.querySelector<HTMLElement>("[role=tablist]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const lanes = [...root.querySelectorAll<HTMLElement>(".tk-tt__lane")];
    if (!tabList || tabs.length === 0) continue;

    root.classList.add("is-tabbed");
    tabList.hidden = false;
    for (const lane of lanes) {
      lane.setAttribute("role", "tabpanel");
      lane.setAttribute("aria-labelledby", `tk-tt-tab-${lane.dataset.track}`);
      lane.tabIndex = 0;
    }

    const show = (track: string | undefined, focus = false) => {
      const tab = tabs.find((t) => t.dataset.track === track);
      if (!tab) return false;
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      }
      for (const lane of lanes) lane.hidden = lane.dataset.track !== track;
      if (focus) tab.focus();
      return true;
    };

    const pick = (track: string | undefined, focus = false) => {
      if (!show(track, focus)) return;
      history.replaceState(null, "", `#${PREFIX}${track}`);
      // A new track starts at its beginning, not somewhere in its afternoon:
      // when the list was read past, go back up to the tabs.
      const top = root.getBoundingClientRect().top;
      const stuck = tabList.getBoundingClientRect().top;
      if (top < stuck - 1) {
        const lane = lanes.find((l) => l.dataset.track === track);
        lane?.scrollIntoView({ block: "start" });
      }
    };

    tabList.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLButtonElement>(
        "[role=tab]",
      );
      if (tab) pick(tab.dataset.track);
    });

    tabList.addEventListener("keydown", (event) => {
      const at = tabs.findIndex(
        (t) => t.getAttribute("aria-selected") === "true",
      );
      const last = tabs.length - 1;
      const to =
        event.key === "ArrowRight"
          ? (at + 1) % tabs.length
          : event.key === "ArrowLeft"
            ? (at + last) % tabs.length
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? last
                : -1;
      if (to < 0) return;
      event.preventDefault();
      pick(tabs[to].dataset.track, true);
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id.startsWith(PREFIX) || !show(id.slice(PREFIX.length))) {
        return false;
      }
      // On a phone the grid's heading is not drawn: go to the track instead.
      if (!document.getElementById(id)?.getClientRects().length) {
        root.scrollIntoView({ block: "start" });
      }
      return true;
    };

    if (!fromHash()) show(tabs[0].dataset.track);
    window.addEventListener("hashchange", fromHash);
  }
</script>

<style>
  .tk-tt {
    scroll-margin-top: var(--tk-header-h);
  }

  .tk-tt__stack {
    display: grid;
    gap: 16px;
  }

  .tk-tt__date {
    margin: 0 0 18px;
    font-family: var(--f-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: right;
  }

  /* ---- grid (wide) --------------------------------------------------- */

  .tk-tt__grid {
    display: grid;
    grid-template-columns: 52px repeat(var(--tracks), minmax(0, 1fr)) 46px;
    gap: 8px 10px;
  }

  .tk-tt__head {
    display: grid;
    align-content: center;
    padding: 8px 14px;
    margin-top: 6px;
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-sm);
    background: var(--trk);
    color: var(--trk-ink);
    line-height: 1.3;
  }

  .tk-tt__head small {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .tk-tt__head b {
    font-family: var(--tk-f-display);
    font-size: 16px;
  }

  .tk-tt__tick {
    grid-column: 1;
    padding-top: 6px;
    border-top: 1.5px solid var(--tk-hair);
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .tk-tt__cell {
    display: grid;
    min-width: 0;
  }

  /* ---- a track at a time (phone) ------------------------------------- */

  .tk-tt__phone {
    display: none;
    scroll-margin-top: var(--tk-header-h);
  }

  .tk-tt__lead {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.7;
  }

  /* The tabs stay under the header while a track is read. */
  .tk-tt__tabs {
    position: sticky;
    top: var(--tk-header-h);
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(var(--tracks), minmax(0, 1fr));
    gap: 6px;
    margin: 0 -8px 16px;
    padding: 10px 8px;
    background: var(--surface);
    border-bottom: 1.5px solid var(--tk-hair);
  }

  .tk-tt__tabs[hidden] {
    display: none;
  }

  /* Each tab carries its track's colour as a band along the top; the open
     one is filled with the track's pastel and lifted, the ink kept dark so
     the yellow track reads as well as the others. */
  .tk-tt__tab {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
    padding: 9px 7px 8px;
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-sm);
    background: var(--surface);
    box-shadow: inset 0 5px 0 var(--trk);
    color: var(--ink);
    font: inherit;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.25s var(--tk-ease),
      color 0.25s var(--tk-ease),
      transform 0.25s var(--tk-ease),
      box-shadow 0.25s var(--tk-ease);
  }

  .tk-tt__tab small {
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  /* Break at the label's spaces (`AIが` / `"動く"`), not inside a word. */
  .tk-tt__tab b {
    font-family: var(--tk-f-display);
    font-size: 12px;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .tk-tt__tab[aria-selected="true"] {
    background: var(--trk-pa);
    transform: translate(-2px, -2px);
    box-shadow:
      inset 0 5px 0 var(--trk),
      3px 3px 0 var(--ink);
  }

  .tk-tt__tab:focus-visible {
    outline: 3px solid var(--tk-accent-deep);
    outline-offset: 2px;
  }

  .tk-tt__side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0 0 18px;
    padding: 9px 14px;
    border: 1.5px dashed var(--ink);
    border-radius: var(--tk-r-sm);
    background: var(--pa-green);
    font-size: 13px;
  }

  .tk-tt__side-tag {
    padding: 1px 9px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--surface);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.7;
  }

  .tk-tt__side b {
    font-family: var(--tk-f-display);
  }

  .tk-tt__side time {
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 700;
  }

  .tk-tt__lane {
    scroll-margin-top: calc(var(--tk-header-h) + 80px);
  }

  .tk-tt__lane + .tk-tt__lane {
    margin-top: 36px;
  }

  .is-tabbed .tk-tt__lane + .tk-tt__lane {
    margin-top: 0;
  }

  .tk-tt__lane:focus-visible {
    outline: 3px solid var(--tk-accent-deep);
    outline-offset: 4px;
    border-radius: var(--tk-r-sm);
  }

  /* The track's theme, before its day. */
  .tk-tt__lane-head {
    display: grid;
    justify-items: start;
    gap: 6px;
    margin-bottom: 18px;
    padding: 14px 16px;
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-sm);
    background: var(--trk-pa);
  }

  .tk-tt__lane-code {
    padding: 1px 10px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--trk);
    color: var(--trk-ink);
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.6;
  }

  .tk-tt__lane-title {
    margin: 0;
    font-family: var(--tk-f-display);
    font-size: 22px;
    line-height: 1.3;
  }

  .tk-tt__lane-sub {
    margin: 0;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.5;
  }

  /*
    The day as a line down the left: a time, and a stop on the line, for
    everything in it. The track's own sessions are stops filled in its
    colour; what everyone attends, hollow ones.
  */
  .tk-tt__flow {
    position: relative;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tk-tt__flow::before {
    content: "";
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 51px;
    width: 3px;
    border-radius: 2px;
    background: var(--trk);
  }

  .tk-tt__step {
    position: relative;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    column-gap: 24px;
    align-items: start;
  }

  .tk-tt__step::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 46px;
    width: 13px;
    aspect-ratio: 1;
    box-sizing: border-box;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
  }

  .tk-tt__step.is-own::before {
    background: var(--trk);
  }

  .tk-tt__step-time {
    padding-top: 2px;
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    text-align: right;
  }

  .tk-tt__step-body {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .tk-tt__step-all {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .tk-tt__note {
    margin: 0 8px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (width < 900px) {
    .tk-tt__grid {
      display: none;
    }

    .tk-tt__phone {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-tt__tab {
      transition: none;
    }
  }
</style>
