---
import RegisterOptions from "./RegisterOptions.astro";
import Icon from "./Icon.astro";
import type { ResolvedTenant } from "../../../tenants";
import { currentLanguage } from "../../../i18n/language";
import { AFTER_PARTY_URL, copy, localized, OVERVIEW } from "../_content";

/**
 * What the page's own register buttons open — the header's, the menu's and
 * the key visual's: the two halves sign up on different pages, so a button
 * that belongs to neither asks which first.
 *
 * A popover, so the browser opens and closes it: a button with
 * `popovertarget="tk-register"` opens it, and Escape, a tap outside or the
 * close button shuts it. The opener's `data-placement` is copied onto the
 * two links as it opens, so a click is still reported as the header's or the
 * key visual's rather than as the popover's.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const lang = currentLanguage();
const c = copy(lang);
---

<div
  class="tk-register"
  id="tk-register"
  popover
  role="dialog"
  aria-labelledby="tk-register-h"
>
  <div class="tk-register__card">
    <div class="tk-register__head">
      <h2 class="tk-register__title" id="tk-register-h">
        {c.registerChoose}
      </h2>
      <button
        type="button"
        class="tk-register__close"
        popovertarget="tk-register"
        popovertargetaction="hide"
      >
        <span class="visually-hidden">{c.close}</span>
        <span class="tk-register__x" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </div>
    <p class="tk-register__lede">{c.registerChooseLede}</p>
    <RegisterOptions site={site} placement="choice" />
    <p class="tk-register__note">
      <span>
        {localized(OVERVIEW.fee, lang)} ※ {localized(OVERVIEW.feeNote, lang)}
      </span>
      <a
        class="tk-register__party"
        href={AFTER_PARTY_URL}
        target="_blank"
        rel="noopener"
      >
        {localized(OVERVIEW.afterParty, lang)}
        <Icon name="external" />
      </a>
    </p>
  </div>
</div>

<script>
  document.addEventListener("click", (event) => {
    const opener = (event.target as Element | null)?.closest<HTMLElement>(
      '[popovertarget="tk-register"]:not([popovertargetaction="hide"])',
    );
    const placement = opener?.dataset.placement;
    if (!placement) return;
    document
      .querySelectorAll<HTMLElement>("#tk-register [data-analytics]")
      .forEach((link) => (link.dataset.placement = placement));
  });
</script>

<style>
  .tk-register {
    width: min(680px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 0.25s var(--tk-ease),
      translate 0.35s var(--tk-ease),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }

  .tk-register:popover-open {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    .tk-register:popover-open {
      opacity: 0;
      translate: 0 16px;
    }
  }

  .tk-register::backdrop {
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .tk-register__card {
    display: grid;
    gap: 14px;
    padding: clamp(20px, 3vw, 28px);
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-lg);
    background: var(--surface);
  }

  .tk-register__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .tk-register__title {
    margin: 0;
    font: 800 clamp(20px, 2.6vw, 26px) / 1.3 var(--tk-f-jp);
  }

  .tk-register__close {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    aspect-ratio: 1;
    border: var(--tk-line) solid var(--ink);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s;
  }

  .tk-register__close:hover {
    background: var(--ht-yellow);
  }

  .tk-register__close:focus-visible {
    outline: 3px solid var(--tk-accent-deep);
    outline-offset: 3px;
  }

  .tk-register__x {
    position: relative;
    width: 16px;
    height: 16px;
  }

  .tk-register__x i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: currentColor;
    rotate: 45deg;
  }

  .tk-register__x i + i {
    rotate: -45deg;
  }

  .tk-register__lede {
    margin: -6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  .tk-register__note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
    margin: 0;
    font-size: 12px;
    color: var(--muted);
  }

  /* The after-party's sign-up: a small aside to its note, not a button. */
  .tk-register__party {
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    text-decoration-color: var(--tk-hair);
    transition: text-decoration-color 0.2s;
  }

  .tk-register__party:hover {
    text-decoration-color: var(--ink);
  }

  .tk-register__party:focus-visible {
    outline: 3px solid var(--tk-accent-deep);
    outline-offset: 2px;
  }

  .tk-register__party :global(svg) {
    width: 11px;
    margin-left: 3px;
    vertical-align: -1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-register {
      transition: none;
    }
  }
</style>
