---
import { getCollection } from "astro:content";
import Props from "./Props.astro";
import Sticker from "./Sticker.astro";
import SessionCard from "./SessionCard.astro";
import { getTracks, pastelCycle } from "../data/tracks";

const tracks = await getTracks();
const allSessions = await getCollection("sessions");
const allSpeakers = await getCollection("speakers");
const speakerById = new Map(allSpeakers.map((s) => [s.id, s]));

// One pastel rotation running through the whole section, so no two adjacent
// speaker blocks land on the same colour regardless of how tracks are filled.
let pastelIndex = 0;

const grouped = tracks
  .map((track) => {
    const sessions = allSessions
      .filter((s) => s.data.track.id === track.id)
      .sort((a, b) => a.data.order - b.data.order)
      .map((session) => {
        const speakers = session.data.speakers.map((ref) => {
          const speaker = speakerById.get(ref.id);
          if (!speaker)
            throw new Error(
              `Session ${session.id} references unknown speaker "${ref.id}"`,
            );
          return speaker;
        });
        return {
          session,
          speakers,
          label:
            track.data.cardLabel ??
            `Session ${String(session.data.order).padStart(2, "0")}`,
          pastel: pastelCycle[pastelIndex++ % pastelCycle.length],
        };
      });
    return { track, sessions };
  })
  .filter((g) => g.sessions.length > 0);
---

<section class="sec tint" id="sessions">
  <Props>
    <Sticker name="dot" width={34} top="5%" right="5%" speed={1.3} />
    <Sticker
      name="slashes"
      width={76}
      top="44%"
      left="1.5%"
      rotate={10}
      speed={-0.9}
    />
    <Sticker
      name="plus"
      width={52}
      bottom="6%"
      right="3%"
      rotate={-14}
      speed={0.8}
    />
  </Props>

  <div class="wrap">
    <p class="eyebrow" data-reveal="up">Sessions &amp; Speakers</p>
    <h2 class="sec-h" data-reveal="up">セッション</h2>
    <p class="sec-lede" data-reveal="up">
      登壇が確定したセッションをご紹介します。
    </p>

    {
      grouped.map(({ track, sessions }) => (
        <>
          <div
            class:list={[
              "track-head",
              { ink: track.data.darkInk, plain: track.data.pending },
            ]}
            style={`--trk:${track.data.color}`}
            data-reveal="up"
          >
            <h3>{track.data.label}</h3>
            <span class="sub">{track.data.sub}</span>
            <span class="count">{sessions.length} sessions</span>
          </div>
          <div
            class="cards"
            style={`--trk:${track.data.textColor}`}
            data-stagger
          >
            {sessions.map((s) => (
              <SessionCard
                session={s.session}
                speakers={s.speakers}
                label={s.label}
                pastel={s.pastel}
              />
            ))}
          </div>
        </>
      ))
    }

    <p class="note">
      ※
      セッションタイトル・内容・登壇形式・トラックは、今後変更となる場合があります。確定した情報から順次更新します。
    </p>
  </div>
</section>

<style>
  .sec {
    border-top: var(--bw) solid var(--stroke);
  }

  .track-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin: 38px 0 16px;
    padding: 11px 20px;
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    background: var(--trk, var(--blue));
    color: #fff;
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .track-head:first-of-type {
    margin-top: 0;
  }

  .track-head h3 {
    font-size: clamp(17px, 2.2vw, 21px);
    margin: 0;
  }

  .sub {
    font-size: 13.5px;
    opacity: 0.92;
    font-family: var(--f-body);
  }

  .count {
    margin-left: auto;
    font-family: var(--f-mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    background: rgb(255 255 255 / 22%);
    border-radius: 999px;
    padding: 2px 12px;
  }

  .track-head.ink {
    color: var(--ink);
  }

  .track-head.ink .count {
    background: rgb(30 30 30 / 16%);
  }

  .track-head.plain {
    background: var(--surface);
    color: var(--ink);
    border-style: dashed;
  }

  .track-head.plain .count {
    background: var(--rule);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 14px;
  }

  .note {
    margin-top: 22px;
  }
</style>
