---
import Logo from "./Logo.astro";
import Props from "./Props.astro";
import Sticker from "./Sticker.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";

const { event, links, tagline } = site;

// The hero only advertises a pre-event while one is actually taking bookings.
const meetups = await getCollection("meetups");
const openMeetup = meetups
  .filter((m) => m.data.status === "open" && m.data.date)
  .sort((a, b) => a.data.no - b.data.no)[0];

const meetupDate = openMeetup?.data.date
  ? `${openMeetup.data.date.getMonth() + 1}/${openMeetup.data.date.getDate()}`
  : null;
const meetupDow = openMeetup?.data.date
  ? ["日", "月", "火", "水", "木", "金", "土"][openMeetup.data.date.getDay()]
  : null;
---

<section class="hero" id="top">
  <Props>
    <Sticker
      name="slashes"
      width={104}
      top="34px"
      right="6%"
      rotate={-8}
      speed={0.9}
    />
    <Sticker
      name="ellipsis"
      width={190}
      bottom="12%"
      right="2%"
      rotate={6}
      speed={-0.7}
    />
    <Sticker name="dot" width={38} top="46%" right="14%" speed={1.5} />
    <Sticker
      name="plus"
      width={62}
      bottom="16%"
      left="2.5%"
      rotate={12}
      speed={-1.1}
    />
  </Props>

  <div class="wrap">
    <div class="lockup" data-intro="1">
      <Logo variant="brackets" class="brackets" />
      <span class="yr">{event.isoDate.slice(0, 4)}</span>
      <span class="where"
        >{event.dateShort} ({event.dayOfWeekEn}) {event.venue.cityEn}</span
      >
    </div>

    <h1 data-intro="2">{site.title}</h1>
    <p class="tagline" data-intro="3">
      {tagline.lead}<em>{tagline.accent}</em>
    </p>

    <div class="metas" data-intro="4">
      <span class="pill"
        ><span class="dot" style="background:var(--blue)"></span><b
          >{event.dateLabel}</b
        >（{event.dayOfWeek}）{event.hoursCompact}</span
      >
      <span class="pill"
        ><span class="dot" style="background:var(--green)"></span>{
          event.venue.name
        }</span
      >
      <span class="pill"
        ><span class="dot" style="background:var(--red)"></span>{
          event.formatShort
        }</span
      >
      <span class="pill"
        ><span class="dot" style="background:var(--yellow)"></span>参加費 <b
          >{event.fee}</b
        ></span
      >
    </div>

    <div class="cta-row" data-intro="5">
      <a class="btn" href={links.register} target="_blank" rel="noopener"
        >connpass で参加登録</a
      >
      <a class="btn ghost" href="#sessions">セッションを見る</a>
      {
        openMeetup && (
          <span class="cta-note">
            プレイベント{" "}
            <a href="#preevent">DevFest Meetup #{openMeetup.data.no}</a> は{" "}
            {meetupDate}（{meetupDow}）開催、受付中です
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(38px, 5.5vw, 64px) 0 clamp(44px, 6vw, 72px);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.8vw, 22px);
    flex-wrap: wrap;
    margin-bottom: clamp(22px, 3vw, 32px);
  }

  .lockup :global(.brackets) {
    width: clamp(190px, 26vw, 300px);
    flex: none;
  }

  .yr {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 20px);
    background: var(--yellow);
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    padding: 4px 18px;
    line-height: 1.6;
  }

  .where {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(14px, 1.7vw, 17px);
    background: var(--surface);
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    padding: 6px 20px;
    line-height: 1.6;
  }

  h1 {
    font-size: clamp(34px, 6.4vw, 72px);
    letter-spacing: -0.03em;
    margin: 0 0 6px;
  }

  .tagline {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(19px, 3.1vw, 34px);
    letter-spacing: -0.01em;
    line-height: 1.4;
    margin: 0 0 clamp(20px, 2.6vw, 28px);
  }

  .tagline em {
    font-style: normal;
    color: var(--t-deep);
  }

  .metas {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: clamp(22px, 3vw, 30px);
  }

  .metas :global(.pill b) {
    font-weight: 700;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
  }

  .cta-note {
    font-size: 13px;
    color: var(--muted);
  }

  /* Entrance state. Cleared by the intro script; never applied without JS. */
  :global(html.js) [data-intro] {
    opacity: 0;
    transform: translateY(14px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-intro] {
      opacity: 1;
      transform: none;
    }
  }
</style>
