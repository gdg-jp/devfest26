---
import Logo from "./Logo.astro";
import Gutter from "./Gutter.astro";
import Sticker from "./Sticker.astro";
import type { ResolvedTenant } from "../tenants";
import { byTenant } from "../data/collections";
import { eventDates } from "../tenants/eventDates";
import { messages } from "../i18n";
import { language } from "../i18n/language";

interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const { event, links, tagline } = site;
const t = messages(language);

// The hero only advertises a pre-event while one is actually taking bookings.
const meetups = await byTenant("meetups", site.tenant);
const openMeetup = meetups
  .filter((m) => m.data.status === "open" && m.data.date)
  .sort((a, b) => a.data.no - b.data.no)[0];

// Pinned to JST via `eventDates`, the same as every other date on the page —
// reading `.getDate()` / `.getDay()` straight off the Date would answer in
// the build machine's timezone instead.
const meetupIso = openMeetup?.data.date?.toISOString();
const meetupDates = meetupIso
  ? eventDates(meetupIso, meetupIso, language)
  : null;
const meetupDate = meetupDates?.dateShort ?? null;
const meetupDow = meetupDates?.dayOfWeek ?? null;
---

<section class="hero" id="top">
  <Gutter>
    <Sticker
      name="slashes"
      width={104}
      top="34px"
      right="6%"
      rotate={-8}
      speed={0.9}
    />
    <Sticker
      name="ellipsis"
      width={190}
      bottom="12%"
      right="2%"
      rotate={6}
      speed={-0.7}
    />
    <Sticker name="dot" width={38} top="46%" right="14%" speed={1.5} />
    <Sticker
      name="plus"
      width={62}
      bottom="16%"
      left="2.5%"
      rotate={12}
      speed={-1.1}
    />
  </Gutter>

  <div class="wrap">
    <div class="lockup" data-intro="1">
      <Logo variant="brackets" class="brackets" />
      <span class="yr">{event.isoDate.slice(0, 4)}</span>
      <span class="where"
        >{event.dateShort} ({event.dayOfWeekEn}) {event.venue.cityEn}</span
      >
    </div>

    <h1 data-intro="2">
      <span class="hero-title">{site.title}</span>
      {site.subtitle && <span class="hero-subtitle">{site.subtitle}</span>}
    </h1>
    <p class="tagline" data-intro="3">
      {tagline.lead}<em>{tagline.accent}</em>
    </p>

    <div class="metas" data-intro="4">
      <span class="pill"
        ><span class="dot" style="background:var(--blue)"></span><b
          >{event.dateLabel}</b
        >{t.dates.dowSuffix(event.dayOfWeek)}{event.hoursCompact}</span
      >
      <span class="pill"
        ><span class="dot" style="background:var(--green)"></span>{
          event.venue.name
        }</span
      >
      <span class="pill"
        ><span class="dot" style="background:var(--red)"></span>{
          event.formatShort
        }</span
      >
      <span class="pill"
        ><span class="dot" style="background:var(--yellow)"></span>{
          t.hero.feeLabel
        }{" "}<b>{event.fee}</b></span
      >
    </div>

    <div class="cta-row" data-intro="5">
      <a class="btn" href={links.register} target="_blank" rel="noopener"
        >{t.hero.registerCta}</a
      >
      <a class="btn ghost" href="#sessions">{t.hero.sessionsCta}</a>
      {
        openMeetup && (
          <span class="cta-note">
            {t.hero.preeventBefore}{" "}
            <a href="#preevent">
              {t.hero.preeventLinkLabel(openMeetup.data.no)}
            </a>{" "}
            {t.hero.preeventAfter(meetupDate ?? "", meetupDow ?? "")}
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(38px, 5.5vw, 64px) 0 clamp(44px, 6vw, 72px);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.8vw, 22px);
    flex-wrap: wrap;
    margin-bottom: clamp(22px, 3vw, 32px);
  }

  .lockup :global(.brackets) {
    width: clamp(190px, 26vw, 300px);
    flex: none;
  }

  .yr {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(15px, 2vw, 20px);
    background: var(--yellow);
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    padding: 4px 18px;
    line-height: 1.6;
  }

  .where {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(14px, 1.7vw, 17px);
    background: var(--surface);
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    padding: 6px 20px;
    line-height: 1.6;
  }

  h1 {
    font-size: clamp(34px, 6.4vw, 72px);
    letter-spacing: -0.03em;
    margin: 0 0 6px;
  }

  .hero-title {
    display: block;
  }

  .hero-subtitle {
    display: block;
    font-size: clamp(24px, 4.4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: clamp(2px, 0.4vw, 6px);
  }

  .tagline {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(19px, 3.1vw, 34px);
    letter-spacing: -0.01em;
    line-height: 1.4;
    margin: 0 0 clamp(20px, 2.6vw, 28px);
  }

  .tagline em {
    font-style: normal;
    color: var(--t-deep);
  }

  .metas {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: clamp(22px, 3vw, 30px);
  }

  .metas :global(.pill b) {
    font-weight: 700;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
  }

  .cta-note {
    font-size: 13px;
    color: var(--muted);
  }

  /* Entrance state. Cleared by the intro script; never applied without JS. */
  :global(html.js) [data-intro] {
    opacity: 0;
    transform: translateY(14px);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-intro] {
      opacity: 1;
      transform: none;
    }
  }
</style>
