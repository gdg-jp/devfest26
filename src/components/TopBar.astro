---
import Logo from "./Logo.astro";
import { site } from "../data/site";
import { home, isHome } from "../lib/url";

// The nav is a set of page anchors, which only resolve on the page that has
// the sections. From a session or speaker page they have to travel home first;
// the scroll-spy simply finds nothing to observe there.
// `home` is `/kansai` here, not `/` — this site is mounted on a path.
const onHome = isHome(Astro.url);
const prefix = onHome ? "" : home;
---

<header class="topbar" data-topbar>
  <div class="wrap">
    <a
      class="home"
      href={onHome ? "#top" : home}
      aria-label={`${site.title} — ${onHome ? "ページ先頭へ" : "トップページへ"}`}
    >
      <Logo variant="primary" class="mark" />
      <span class="edition">{site.editionEn}</span>
    </a>
    <nav aria-label="セクションナビゲーション">
      {
        site.nav.map((item) => (
          <a href={prefix + item.href} data-spy={item.href.slice(1)}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="btn sm" href={site.links.register} target="_blank" rel="noopener"
      >参加登録</a
    >
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: var(--bw) solid var(--stroke);
    transition: box-shadow 0.25s ease;
  }

  .topbar :global(.wrap) {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 11px 0;
    transition: padding 0.25s var(--ease-out);
  }

  /* Set by the nav script once the hero is behind us. */
  .topbar:global(.is-stuck) {
    box-shadow: 0 6px 22px rgb(30 30 30 / 9%);
  }

  .topbar:global(.is-stuck) :global(.wrap) {
    padding: 6px 0;
  }

  /* Shrinkable, so a long city name gives way to the register button on a
     narrow phone rather than pushing the bar into a horizontal scroll. The
     lockup itself never shrinks. */
  .home {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    line-height: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .home:hover :global(.mark) {
    transform: rotate(-1.5deg) scale(1.02);
  }

  .home :global(.mark) {
    flex: none;
    width: 150px;
    transition: transform 0.2s var(--ease-spring);
  }

  /* The lockup is a ~17x reduction of outlines that carry no hinting, so at 1x
     coverage antialiasing spreads every stem across two pixel columns and the
     mark reads as grey mush. Dropping antialiasing snaps the stems to whole
     pixels instead — the closest a path gets to what the type beside it
     receives for free. A 2x display has the pixels to draw it properly, and
     there the stair-stepping would be the worse trade. */
  @media (resolution: 1x) {
    .home :global(.mark) {
      shape-rendering: crispEdges;
    }
  }

  /* The city sits beside the lockup behind a hairline, so it reads as an
     edition of DevFest rather than as part of the wordmark itself. */
  .edition {
    padding-left: 10px;
    border-left: var(--bw) solid var(--stroke);
    font-family: var(--f-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: font-size 0.25s var(--ease-out);
  }

  .topbar:global(.is-stuck) .edition {
    font-size: 15px;
  }

  nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 500;
  }

  nav a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    padding: 3px 0;
  }

  /* Underline grows from the left rather than switching on, so the active
     section reads as travel down the page. */
  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.5px;
    background: var(--t);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s var(--ease-out);
  }

  nav a:hover::after,
  nav a:global(.is-current)::after {
    transform: scaleX(1);
  }

  nav a:global(.is-current) {
    color: var(--t-deep);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--bw) * -1);
    height: var(--bw);
  }

  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--t);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (width <= 900px) {
    nav {
      display: none;
    }

    .topbar :global(.wrap) {
      gap: 12px;
    }

    .topbar :global(.btn.sm) {
      margin-left: auto;
    }
  }

  /* Narrow phones: the lockup, the city and the register button have to share
     one line, so both halves of the lockup give up a little width. */
  @media (width <= 480px) {
    .home {
      gap: 7px;
    }

    .home :global(.mark) {
      width: 118px;
    }

    .edition,
    .topbar:global(.is-stuck) .edition {
      padding-left: 7px;
      font-size: 13.5px;
    }
  }
</style>
