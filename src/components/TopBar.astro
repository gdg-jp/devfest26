---
import Logo from './Logo.astro';
import { site } from '../data/site';
---

<header class="topbar" data-topbar>
  <div class="wrap">
    <a class="home" href="#top" aria-label={`${site.title} — ページ先頭へ`}>
      <Logo variant="primary" class="mark" />
    </a>
    <nav aria-label="セクションナビゲーション">
      {site.nav.map((item) => <a href={item.href} data-spy={item.href.slice(1)}>{item.label}</a>)}
    </nav>
    <a class="btn sm" href={site.links.register} target="_blank" rel="noopener">参加登録</a>
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: var(--bw) solid var(--stroke);
    transition: box-shadow 0.25s ease;
  }

  .topbar :global(.wrap) {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 11px 0;
    transition: padding 0.25s var(--ease-out);
  }

  /* Set by the nav script once the hero is behind us. */
  .topbar:global(.is-stuck) {
    box-shadow: 0 6px 22px rgb(30 30 30 / 9%);
  }

  .topbar:global(.is-stuck) :global(.wrap) {
    padding: 6px 0;
  }

  .home {
    display: block;
    flex: none;
    line-height: 0;
  }

  .home:hover :global(.mark) {
    transform: rotate(-1.5deg) scale(1.02);
  }

  .home :global(.mark) {
    width: 150px;
    transition: transform 0.2s var(--ease-spring);
  }

  nav {
    display: flex;
    gap: 20px;
    margin-left: auto;
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 500;
  }

  nav a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    padding: 3px 0;
  }

  /* Underline grows from the left rather than switching on, so the active
     section reads as travel down the page. */
  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.5px;
    background: var(--t);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s var(--ease-out);
  }

  nav a:hover::after,
  nav a:global(.is-current)::after {
    transform: scaleX(1);
  }

  nav a:global(.is-current) {
    color: var(--t-deep);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--bw) * -1);
    height: var(--bw);
  }

  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--t);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (width <= 900px) {
    nav {
      display: none;
    }

    .topbar :global(.wrap) {
      gap: 12px;
    }

    .topbar :global(.btn.sm) {
      margin-left: auto;
    }
  }
</style>
