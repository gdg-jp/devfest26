---
import { Image } from "astro:assets";
import type { ResolvedTenant } from "../tenants";
import { BACKDROP_QUALITY, BACKDROP_WIDTH, isRemotePhoto } from "../lib/photo";
import { registerBackdrop } from "../lib/photos";
import { messages } from "../i18n";
import { currentLanguage } from "../i18n/language";

interface Props {
  site: ResolvedTenant;
  /**
   * A city's own words for the closing ask, each optional. Left out, the
   * section reads as it always has.
   */
  heading?: string;
  lede?: string;
  cta?: string;
  note?: string;
}

const { site, heading, lede, cta, note } = Astro.props;
const { event, links } = site;
const t = messages(currentLanguage());

const backdrop = await registerBackdrop(site.tenant);
---

<section class="register" id="register">
  {
    backdrop && (
      <div class="bd" aria-hidden="true">
        {isRemotePhoto(backdrop.image) ? (
          <img
            src={backdrop.image.src}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={backdrop.image}
            alt=""
            width={BACKDROP_WIDTH}
            quality={BACKDROP_QUALITY}
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    )
  }

  <div class="wrap">
    <p class="eyebrow mid" data-reveal="up">Join us</p>
    <h2 data-reveal="up">
      {
        heading ?? (
          <>
            {t.register.headingLine1}
            <br />
            {t.register.headingLine2(event.monthDay, event.venue.city)}
          </>
        )
      }
    </h2>
    <p data-reveal="up">
      {lede ?? t.register.lede(site.title)}
    </p>
    <div class="cta-row" data-reveal="up">
      <a
        class="btn"
        href={links.register}
        target="_blank"
        rel="noopener"
        data-analytics="register_click"
        data-placement="section"
      >
        {cta ?? t.register.ctaRegister}
      </a>
      <a
        class="btn ghost"
        href={links.community}
        target="_blank"
        rel="noopener"
      >
        {t.register.ctaCommunity(event.host)}
      </a>
    </div>
    <p class="reg-note" data-reveal="up">
      {note ?? t.register.note(event.fee)}
    </p>
  </div>
</section>

<style>
  /*
    The loudest surface on the page, and it belongs to the main event.

    On the stage rather than on a flat --t, so the page closes on the same dark
    it opened on: the hero announces the day, the programme is read on paper,
    and the lights go back down to ask. The hem at the top is the hero's, the
    other way up.
  */
  .register {
    position: relative;
    /* Makes this the blend boundary, so .bd multiplies with --t and not with
       whatever the page happens to be painting behind the section. */
    isolation: isolate;
    background: var(--t);
    color: var(--t-on);
    border-top: var(--bw) solid var(--stroke);
    padding: clamp(52px, 6.6vw, 84px) 0 clamp(62px, 7.6vw, 92px);
    text-align: center;
    overflow: hidden;
  }

  /*
    A plain wash, not the `multiply` this used when the ground was a flat --t.
    Multiply can only darken, which is exactly what made it work over a mid
    blue and exactly what makes it useless over a near-black stage — there is
    nothing left to darken and the photograph disappears.

    At this strength the picture's brightest areas land around #4a4a4a, so the
    white copy over it keeps better than 7:1 wherever the photo is strongest.
  */
  .bd {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0.62;
    mix-blend-mode: multiply;
  }

  /*
    Narrow screens get less of it. Not for contrast -- multiply cannot hurt
    that -- but because the copy stops being a centred column with clear photo
    around it and starts covering the whole section, so every line lands on
    the picture's detail rather than beside it.
  */
  @media (width < 1100px) {
    .bd {
      opacity: 0.45;
    }
  }

  .bd :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .register .wrap {
    position: relative;
    z-index: 1;
  }

  h2 {
    font-size: clamp(26px, 4.2vw, 42px);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  p {
    max-width: 60ch;
    margin-inline: auto;
    font-size: clamp(15px, 1.7vw, 17px);
  }

  .register :global(.eyebrow) {
    /* Not `opacity` — that belongs to the scroll reveal on this element. */
    color: color-mix(in srgb, currentcolor 85%, transparent);
  }

  .register :global(.eyebrow::before) {
    background: var(--surface);
    border-color: var(--ink);
  }

  /* On a solid tenant ground the primary action inverts to white. */
  .register :global(.btn) {
    background: var(--surface);
    color: var(--ink);
  }

  .register :global(.btn.ghost) {
    background: transparent;
    color: inherit;
    border-color: currentcolor;
    box-shadow: 0 4px 0 currentcolor;
  }

  .register :global(.btn.ghost:hover) {
    box-shadow: 0 6px 0 currentcolor;
  }

  .register :global(.btn.ghost:active) {
    box-shadow: 0 2px 0 currentcolor;
  }

  .register :global(.cta-row) {
    justify-content: center;
    margin-top: 26px;
  }

  .reg-note {
    margin-top: 20px;
    font-size: 13px;
    color: color-mix(in srgb, currentcolor 82%, transparent);
  }

  [data-reveal] {
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.55s var(--ease-out);
  }
</style>
