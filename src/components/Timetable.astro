---
import Eyebrow from "./Eyebrow.astro";
/**
 * The day as a list of time slots, built from the sessions rather than written
 * out.
 *
 * It used to be a proportional grid: four columns, row heights in minutes, the
 * whole thing scrolled sideways on anything narrower than a laptop with the
 * clock column pinned. That shape cost more than it bought. A row whose height
 * is its duration spends a screenful of empty space on the lunch break; the
 * sideways scroll put three of the four tracks off-screen on a phone, which is
 * where most of the traffic is; and the pinned header had to live in a second
 * scroller synchronised to the first in JavaScript, which meant the column
 * labels visibly lagged behind their columns for the length of every swipe.
 *
 * So: one slot per start time, cards inside it. Nothing scrolls sideways, which
 * is what removes that last bug rather than patching it. On a wide screen the
 * cards still sit in their track's column, so the shape of the day is legible
 * at a glance; below 900px they stack, which is the only honest answer to four
 * parallel tracks on a phone.
 *
 * The track filter is what the grid's columns were really for — following one
 * track down the day — offered directly instead of asked of the eye.
 */
import SpeakerAvatar from "./SpeakerAvatar.astro";
import { getTimetable, type TimetableCell } from "../data/timetable";
import { getTracks, type Track } from "../data/tracks";
import { speakerHref } from "../data/program";
import type { ResolvedTenant } from "../tenants";
import { messages } from "../i18n";
import { currentLanguage } from "../i18n/language";

interface Props {
  site: ResolvedTenant;
  /**
   * Session slugs to badge as highlights. Optional, and a city that names none
   * gets the list exactly as before.
   */
  featured?: readonly string[];
  /** The badge's text, in the city's own words. */
  featuredLabel?: string;
}

const { site, featured = [], featuredLabel = "Pick" } = Astro.props;
const t = messages(currentLanguage());
const isFeatured = (key: string) =>
  featured.some((slug) => key === `session:${slug}`);

// "3 トラック" is a fact about this city's configuration, not a constant.
const trackCount = (await getTracks(site.tenant)).filter(
  (track) => !track.data.pending,
).length;

const timetable = await getTimetable(site);
const tracks = timetable?.tracks ?? [];

/**
 * The tracks a cell covers. Cells carry grid lines rather than track ids —
 * column 1 was the clock — so this reads them back off the column list the
 * lines were cut from.
 */
const tracksOf = (cell: TimetableCell): Track[] =>
  tracks.slice(cell.columnStart - 2, cell.columnEnd - 2);

interface Slot {
  start: string;
  cells: TimetableCell[];
}

/*
  One slot per distinct start time, in order, each holding whatever begins then
  — left to right in track order, so a slot reads across the day the way the
  columns used to read down it.
*/
const slots: Slot[] = [...(timetable?.cells ?? [])]
  .sort((a, b) =>
    a.start === b.start
      ? a.columnStart - b.columnStart
      : a.start < b.start
        ? -1
        : 1,
  )
  .reduce<Slot[]>((found, cell) => {
    const last = found.at(-1);
    if (last?.start === cell.start) last.cells.push(cell);
    else found.push({ start: cell.start, cells: [cell] });
    return found;
  }, []);

/** The portrait beside a speaker's name on a card, as the session cards set it. */
const FACE = 36;
---

<section class="sec" id="timetable">
  <div class="wrap">
    <Eyebrow mark="semicolon">Timetable</Eyebrow>
    <h2 class="sec-h" data-reveal="up">{t.timetable.heading}</h2>
    <p class="sec-lede" data-reveal="up">
      {t.timetable.lede(trackCount, Boolean(timetable))}
    </p>

    {
      timetable && (
        <div class="tt" data-tt data-reveal="up">
          {tracks.length > 1 && (
            <div
              class="filter"
              role="group"
              aria-label={t.timetable.filterAria}
            >
              <button type="button" data-tt-filter="" aria-pressed="true">
                {t.timetable.filterAll}
              </button>
              {tracks.map((track) => (
                <button
                  type="button"
                  class="trk-btn"
                  data-tt-filter={track.id}
                  aria-pressed="false"
                  style={`--trk:${track.data.color}`}
                >
                  {track.data.label}
                </button>
              ))}
            </div>
          )}

          <div class="heads" style={`--tracks:${tracks.length}`}>
            <div class="rail" aria-hidden="true" />
            <div class="heads-in">
              {tracks.map((track) => (
                <p
                  class:list={["head", { ink: track.data.darkInk }]}
                  style={`--trk:${track.data.color}`}
                >
                  <b>{track.data.label}</b>
                  <span>{track.data.sub}</span>
                </p>
              ))}
            </div>
          </div>

          <ol class="slots" style={`--tracks:${tracks.length}`}>
            {slots.map((slot) => (
              <li class="slot" data-tt-slot>
                <div class="rail">
                  <time class="at">{slot.start}</time>
                </div>

                <ul class="cards">
                  {slot.cells.map((cell) => {
                    const on = tracksOf(cell);

                    return (
                      <li
                        class:list={["card", cell.kind]}
                        data-track={on.map((track) => track.id).join(" ")}
                        style={`--cs:${cell.columnStart - 1};--ce:${cell.columnEnd - 1}${cell.fill ? `;--pa:${cell.fill}` : ""}`}
                      >
                        <div class:list={["face", { linkbox: cell.href }]}>
                          <p class="meta">
                            {cell.kind === "session" &&
                              on.map((track) => (
                                <span
                                  class:list={[
                                    "trk",
                                    { ink: track.data.darkInk },
                                  ]}
                                  style={`--trk:${track.data.color}`}
                                >
                                  {track.data.label}
                                </span>
                              ))}
                            <span class="span">
                              {cell.start} – {cell.end}
                            </span>
                            {isFeatured(cell.key) && (
                              <span class="pick">{featuredLabel}</span>
                            )}
                          </p>

                          <b>
                            {cell.href ? (
                              <a class="stretch" href={cell.href}>
                                {cell.label}
                              </a>
                            ) : (
                              cell.label
                            )}
                          </b>

                          {cell.note && <p class="note-in">{cell.note}</p>}

                          {cell.speakers.length > 0 && (
                            <ul class="who">
                              {cell.speakers.map((speaker) => (
                                <li>
                                  <a href={speakerHref(speaker)}>
                                    <SpeakerAvatar
                                      speaker={speaker}
                                      size={FACE}
                                    />
                                    <span class="who-text">
                                      <b>{speaker.data.name}</b>
                                      <small>{speaker.data.role}</small>
                                    </span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      timetable && timetable.undated.length > 0 && (
        <div class="tbd" data-reveal="up">
          <b>{t.timetable.tbdHeading}</b>
          <ul>
            {timetable.undated.map((session) => (
              <li>
                <a href={session.href}>
                  {session.entry.data.title ??
                    session.talks[0]?.title ??
                    session.label}
                </a>
                <span>{session.track.data.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <p class="note">{t.timetable.note}</p>
  </div>
</section>

<style>
  .tt {
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  /* ---- the track filter ------------------------------------------------- */

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .filter button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: var(--bw) solid var(--stroke);
    border-radius: 999px;
    padding: 7px 17px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 13.5px;
    line-height: 1.5;
    cursor: pointer;
    transition:
      background-color 0.16s var(--ease-out),
      box-shadow 0.14s var(--ease-out),
      transform 0.14s var(--ease-out);
  }

  /* The dot is the track's colour, which is the only thing carrying the colour
     now that the button itself has to stay readable in both states. */
  .filter .trk-btn::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--stroke);
    background: var(--trk);
    flex: none;
  }

  .filter button:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--stroke);
  }

  .filter button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--surface);
  }

  /* ---- the track headers ------------------------------------------------ */

  /*
    The columns named once, at the top of the day. It can be sticky without any
    of the trouble the old grid had with it: that one lived in a horizontal
    scroller of its own and had to be kept in step with the body in JavaScript,
    where this is a row in the same single column of page the slots are in.
  */
  .heads {
    position: sticky;
    top: var(--topbar-h);
    z-index: 3;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
    margin-bottom: 10px;
    background: var(--ground);
    padding: 6px 0;
  }

  .heads-in {
    display: grid;
    grid-template-columns: repeat(var(--tracks), minmax(0, 1fr));
    gap: 8px;
  }

  .head {
    margin: 0;
    padding: 7px 12px;
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-sm);
    background: var(--trk);
    color: #fff;
    line-height: 1.25;
  }

  .head.ink {
    color: var(--ink);
  }

  .head b {
    display: block;
    font-family: var(--f-display);
    font-size: 13.5px;
  }

  .head span {
    font-size: 10.5px;
    opacity: 0.9;
  }

  /* Four names do not fit across a phone, and below that width the cards carry
     their own badge instead. */
  @media (width <= 900px) {
    .heads {
      display: none;
    }
  }

  /* Filtered to one track, the row above says the same thing the one pressed
     button already does. */
  .tt:global(.is-filtered) .heads {
    display: none;
  }

  /* ---- the slots -------------------------------------------------------- */

  .slots {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  .slot {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
  }

  /* A hairline down the left of the day, so the slots read as one column of
     time rather than as a stack of unrelated blocks. It is drawn on the rail
     rather than on the slot so it stops at the last time written, not at the
     bottom of the last card. */
  .rail {
    position: relative;
    padding: 10px 0 18px;
    text-align: right;
  }

  .rail::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 0;
    right: 4px;
    width: 1.5px;
    background: var(--rule);
  }

  .slot:last-child .rail::before {
    display: none;
  }

  .at {
    position: relative;
    display: inline-block;
    padding-right: 14px;
    font-family: var(--f-mono);
    font-weight: 700;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .at::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    border: 2px solid var(--stroke);
    background: var(--surface);
  }

  /* ---- the cards -------------------------------------------------------- */

  .cards {
    display: grid;
    grid-template-columns: repeat(var(--tracks), minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }

  .card {
    grid-column: var(--cs) / var(--ce);
    display: flex;
  }

  /* Filtered to one track, the columns have nothing to hold: the cards that are
     left would stand in a single narrow stripe with three empty ones beside
     them. The list collapses to full width instead. */
  .tt:global(.is-filtered) .cards {
    grid-template-columns: minmax(0, 1fr);
  }

  .tt:global(.is-filtered) .card {
    grid-column: auto;
  }

  .card:global(.is-hidden),
  .slot:global(.is-hidden) {
    display: none;
  }

  .card .face {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
    padding: 14px 16px;
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-md);
    background: var(--pa, var(--surface));
    color: inherit;
    text-decoration: none;
  }

  /*
    The card is a frame that follows the session, not a link that is one: the
    people on it have pages of their own and an <a> cannot be nested inside
    another. `.linkbox` in base.css is the answer the rest of the site already
    uses — the title carries `.stretch`, which grows an invisible layer over
    the whole card, and every other link in the box is positioned, which paints
    it above that layer and leaves it clickable in its own right.
  */
  .face:global(.linkbox) {
    transition:
      transform 0.14s ease,
      box-shadow 0.14s ease;
  }

  .face:global(.linkbox):hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--stroke);
  }

  .face:global(.linkbox):hover b a {
    text-decoration: underline;
  }

  .card b a {
    color: inherit;
    text-decoration: none;
  }

  /* A break is the frame of the day rather than the programme, so it takes no
     track colour and no outline — the figure and the ground must not read
     alike. */
  .card.fixture .face {
    border: 0;
    background: var(--ground);
    color: var(--muted);
    align-items: flex-start;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin: 0;
  }

  /* The header row names the columns while it is on screen, so the badge is
     what takes over below 900px where that row is gone. */
  /* Two positive rules rather than `:not(:global(.is-filtered))`: Astro leaves
     a `:global()` inside `:not()` in the output verbatim, which is not a valid
     selector, and the whole rule is dropped. The second rule wins on
     specificity. */
  @media (width > 900px) {
    .tt .trk {
      display: none;
    }

    .tt:global(.is-filtered) .trk {
      display: inline-flex;
    }
  }

  .trk {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1.5px solid var(--stroke);
    padding: 1px 10px;
    background: var(--trk);
    color: #fff;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 11px;
    line-height: 1.6;
  }

  .trk.ink {
    color: var(--ink);
  }

  .span {
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  /* A highlight the city picked. The theme colour on its own, the one solid
     fill on a list of pastels, so it is found before it is read. */
  .pick {
    padding: 1px 9px;
    border: 1.5px solid var(--stroke);
    border-radius: 999px;
    background: var(--t);
    color: var(--t-on);
    font-family: var(--f-display);
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.6;
  }

  .card b {
    font-family: var(--f-display);
    font-size: 15px;
    line-height: 1.45;
  }

  .note-in {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  /*
    One row per speaker — portrait, name, affiliation — which is how the
    session cards on the deployed site introduce a person, and the form a
    reader can actually pick a name out of. Each row is its own link: the pile
    of faces this replaced said who was on but led nowhere.
  */
  .who {
    display: grid;
    gap: 0;
    margin: auto 0 0;
    padding: 8px 0 0;
    list-style: none;
  }

  .who li + li {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1.5px solid var(--rule);
  }

  .who a {
    display: flex;
    align-items: center;
    gap: 9px;
    color: inherit;
    text-decoration: none;
  }

  .who-text {
    min-width: 0;
  }

  .who-text b {
    display: block;
    font-family: var(--f-display);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.45;
  }

  .who-text small {
    display: block;
    /* An affiliation is a sentence and a card is a glance, so it is cut rather
       than allowed to set the card's height. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 11px;
    line-height: 1.45;
    color: var(--muted);
  }

  .who a:hover .who-text b {
    text-decoration: underline;
  }

  .who :global(.av) {
    transition: transform 0.16s var(--ease-spring);
  }

  .who a:hover :global(.av) {
    transform: scale(1.12);
  }

  /* ---- phone ------------------------------------------------------------ */

  /* Four parallel tracks have no honest side-by-side form on a phone, so the
     slot's cards stack and the time moves above them. */
  @media (width <= 900px) {
    .slot {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .rail {
      padding: 14px 0 4px;
      text-align: left;
    }

    .rail::before {
      display: none;
    }

    .at {
      padding: 0 0 0 16px;
      font-size: 13px;
    }

    .at::after {
      right: auto;
      left: 0;
    }

    .cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .card {
      grid-column: auto;
    }
  }

  /* ---- what is not placed yet ------------------------------------------- */

  .tbd {
    margin-top: 22px;
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: 14px 18px;
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .tbd > b {
    font-family: var(--f-display);
    font-size: 14px;
  }

  .tbd ul {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .tbd li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
    font-size: 14px;
  }

  .tbd li span {
    font-size: 12px;
    color: var(--muted);
  }
</style>
