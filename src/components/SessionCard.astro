---
import { render } from "astro:content";
import SpeakerRow from "./SpeakerRow.astro";
import { pastelCycle } from "../data/tracks";
import type { ProgramSession } from "../data/program";

interface Props {
  session: ProgramSession;
  /** Where this card picks up the section-wide pastel rotation. */
  pastelFrom: number;
}

const { session, pastelFrom } = Astro.props;
const { entry, label, href, talks } = session;
const { Content } = await render(entry);

const hasTitle = Boolean(entry.data.title);
const abstract = entry.body?.trim();

// A session holds either one synthesised talk — itself — or one per real
// entry, never a mix; see src/data/program.ts. When it lists real talks the
// list is the content of the card, so an empty session body is not a gap worth
// apologising for.
const listsTalks = talks[0].standalone;

/*
  Each pastel block leads to the one thing it is about: its own talk where a
  city splits a session into several, or the person on stage where the block is
  one speaker and nothing else. A block naming several people is about no one
  of them, so it stays part of the card and leads to the session — the names
  inside are still their own links either way.
*/
const blocks = talks.map((talk) => ({
  talk,
  toSpeaker: !talk.standalone && talk.speakers.length === 1,
}));
---

<article class="card linkbox" data-reveal="up">
  <div class="card-top">
    <p class="no">{label}</p>
    <h4 class:list={{ tbd: !hasTitle }}>
      <a class="stretch" href={href}>{entry.data.title ?? "TBD"}</a>
    </h4>
    {
      abstract ? (
        <div class="abst">
          <Content />
        </div>
      ) : (
        !listsTalks && <p class="abst tbd">セッション概要は調整中です。</p>
      )
    }
  </div>

  <div class="talks">
    {
      blocks.map(({ talk, toSpeaker }, i) => (
        <div
          class:list={["talk", { linkbox: talk.standalone || toSpeaker }]}
          style={`--pa:var(--pa-${pastelCycle[(pastelFrom + i) % pastelCycle.length]})`}
        >
          {talk.standalone && (
            <h5 class="talk-t">
              <a class="stretch" href={talk.href}>
                {talk.title ?? "TBD"}
              </a>
            </h5>
          )}
          {talk.speakers.map((speaker) => (
            <SpeakerRow speaker={speaker} stretch={toSpeaker} />
          ))}
        </div>
      ))
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-md);
    background: var(--surface);
    overflow: hidden;
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.28s var(--ease-out),
      box-shadow 0.28s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 0 -2px var(--stroke);
  }

  /* While the reveal is still running, the hover lift must not fight it. */
  .card:not(:global(.is-revealed)):hover {
    transform: none;
    box-shadow: none;
  }

  .card-top {
    padding: 18px 20px 0;
  }

  .no {
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--trk, var(--t-deep));
    margin: 0;
  }

  h4 {
    font-size: 17.5px;
    margin: 6px 0 8px;
    letter-spacing: -0.01em;
  }

  h4.tbd {
    color: var(--muted);
    font-weight: 500;
  }

  /* Titles are links to the session's own page but should not read as a row
     of links; the underline arrives on hover. */
  h4 a,
  .talk-t a {
    color: inherit;
    text-decoration: none;
  }

  h4 a:hover,
  .talk-t a:hover {
    text-decoration: underline;
  }

  .abst {
    font-size: 14.2px;
    line-height: 1.8;
    color: var(--ink);
  }

  .abst.tbd {
    color: var(--muted);
  }

  .abst :global(p) {
    margin: 0 0 0.7em;
  }

  .abst :global(p:last-child) {
    margin-bottom: 0;
  }

  .talks {
    margin-top: auto;
  }

  .talk {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px 20px;
    border-top: 1.5px solid var(--rule);
    background: var(--pa, var(--t-pa));
  }

  .talk-t {
    font-family: var(--f-display);
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0;
  }
</style>
