---
import { Image } from "astro:assets";
import type { ResolvedTenant } from "../tenants";
import {
  BACKDROP_QUALITY,
  BACKDROP_WIDTH,
  COUNTDOWN_BACKDROP_RATIO,
  isRemotePhoto,
} from "../lib/photo";
import { countdownBackdrop } from "../lib/photos";

interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;

const backdrop = await countdownBackdrop(site.tenant);
const backdropHeight = Math.round(BACKDROP_WIDTH * COUNTDOWN_BACKDROP_RATIO);

const cells = [
  { key: "d", label: "Days" },
  { key: "h", label: "Hours" },
  { key: "m", label: "Minutes" },
  { key: "s", label: "Seconds" },
];
---

<div class="band pa cd-band">
  {
    backdrop && (
      <div class="bd" aria-hidden="true">
        {isRemotePhoto(backdrop.image) ? (
          <img
            src={backdrop.image.src}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={backdrop.image}
            alt=""
            width={BACKDROP_WIDTH}
            height={backdropHeight}
            quality={BACKDROP_QUALITY}
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    )
  }

  <div class="countdown wrap">
    <div class="cd-head">
      <h2>開催まで</h2>
      <span class="when">{site.event.countdownLabel}</span>
    </div>
    <div
      class="cd-grid"
      role="timer"
      aria-live="off"
      data-countdown={site.event.startsAt}
    >
      {
        cells.map((c) => (
          <div class="cd-cell" data-reveal="scale">
            <div class="cd-num" data-cd={c.key}>
              —
            </div>
            <div class="cd-lab">{c.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .cd-band {
    position: relative;
    /* Makes this the blend boundary, so .bd multiplies with --t-pa. */
    isolation: isolate;
    overflow: hidden;
  }

  /*
    The same trick as the register panel, upside down.

    There the ground is a saturated --t under white text, so `multiply` can
    only help. Here the ground is a pale --t-pa under dark ink, so multiply
    costs contrast instead of buying it — which is why this one has a ceiling
    the other does not. Measured over the header strip, blurred to text scale,
    across all four city palettes:

      flat --t-pa, no photo   12.5 - 13.9 : 1
      multiply 0.45           5.5 - 6.0 : 1
      multiply 0.6            3.9 - 4.2 : 1   (below AA, not used)

    The digits themselves never enter into it: they sit on opaque white cards,
    so the photo shows in the strip above them and the margins around them and
    touches nothing that has to be read.
  */
  .bd {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.45;
    mix-blend-mode: multiply;
  }

  .bd :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .countdown {
    padding: clamp(28px, 3.6vw, 40px) 0;
  }

  .cd-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 16px;
    margin-bottom: 18px;
  }

  .cd-head h2 {
    font-size: clamp(19px, 2.4vw, 25px);
  }

  .when {
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 700;
  }

  .cd-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(8px, 1.4vw, 16px);
  }

  .cd-cell {
    background: var(--surface);
    border: var(--bw) solid var(--stroke);
    border-radius: var(--r-md);
    padding: clamp(12px, 1.8vw, 20px) 8px;
    text-align: center;
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .cd-num {
    font-family: var(--f-mono);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: clamp(30px, 6vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .cd-lab {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 4px;
  }
</style>
