---
import Logo from "./Logo.astro";
import type { ResolvedTenant } from "../tenants";
import { photoCredits } from "../lib/photos";
import { isHome, tenantHome } from "../lib/url";
import { messages } from "../i18n";
import {
  alternatePath,
  currentAlternateLanguage,
  currentLanguage,
  LANGUAGE_NAMES,
} from "../i18n/language";

interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const t = messages(currentLanguage());
const { event } = site;
const year = new Date().getFullYear();

// Same as the topbar: these are anchors into the home page, so a detail page
// has to send them there rather than to a section it does not have.
const prefix = isHome(Astro.url, site.tenant) ? "" : tenantHome(site.tenant);

// Decorative use does not waive the photographer's credit.
const credits = await photoCredits(site.tenant);

const switchTo = currentAlternateLanguage();
const switchHref = alternatePath(Astro.url.pathname);
const switchLabel = LANGUAGE_NAMES[switchTo];
---

<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <Logo variant="primary" class="foot-mark" />
        <p class="foot-title">{site.fullTitle ?? site.title}</p>
        <p class="foot-sub">
          {event.isoDate.replace(/-/g, ".")}
          {event.dayOfWeekEn.toUpperCase()} ／ {event.venue.name}
        </p>
      </div>
      <div>
        <nav class="foot-nav" aria-label={t.footer.navAria}>
          {
            site.footerNav.map((item) => (
              <a href={prefix + item.href}>{item.label}</a>
            ))
          }
        </nav>
        <div class="tags">
          <span class="tag" style="background:var(--t-pa)"
            >Hosted by {event.host}</span
          >
          <a
            class="tag link"
            href={site.links.connpass}
            target="_blank"
            rel="noopener"
          >
            connpass
          </a>
          {
            /*
              Beside connpass rather than instead of it, and in both languages.
              These are the two places the chapter publishes its events, not two
              translations of one place — an English reader may well want the
              connpass page, and a Japanese reader the Luma one. The register
              button is the one that does choose; see `links.register`.

              The names are not translated because they are not words: they are
              what the two sites call themselves.
            */
            site.links.luma && (
              <a
                class="tag link"
                href={site.links.luma}
                target="_blank"
                rel="noopener"
              >
                Luma
              </a>
            )
          }
          <a
            class="tag link"
            href={site.links.community}
            target="_blank"
            rel="noopener"
          >
            GDG Chapter
          </a>
          <a class="tag link" href={switchHref} hreflang={switchTo}>
            {switchLabel}
          </a>
        </div>
      </div>
    </div>

    <p class="copy colophon">
      © {year}
      {event.host}
      {
        credits.length > 0 && (
          <> ／ Photos: {credits.join(t.common.nameSeparator)}</>
        )
      }
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: var(--bw) solid var(--stroke);
    background: var(--surface);
    padding: clamp(34px, 4.4vw, 52px) 0 28px;
  }

  .foot-top {
    display: flex;
    flex-wrap: wrap;
    gap: 26px 40px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .foot-top :global(.foot-mark) {
    width: min(280px, 70vw);
  }

  .foot-title {
    margin: 14px 0 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 18px;
  }

  .foot-sub {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    font-family: var(--f-display);
    font-size: 14.5px;
  }

  .foot-nav a {
    color: var(--ink);
    text-decoration: none;
  }

  .foot-nav a:hover {
    text-decoration: underline;
  }

  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .tag.link {
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.15s var(--ease-spring);
  }

  .tag.link:hover {
    transform: translateY(-2px);
    background: var(--t-pa);
  }

  .colophon {
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1.5px solid var(--rule);
    font-size: 12.6px;
    color: var(--muted);
    line-height: 1.9;
  }

  .copy {
    margin: 10px 0 0;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
