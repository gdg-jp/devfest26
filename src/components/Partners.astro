---
import { getCollection, render } from 'astro:content';

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  partners.map(async (p) => ({ data: p.data, Content: (await render(p)).Content })),
);
---

<section class="sec tint bordered" id="partners">
  <div class="wrap">
    <p class="eyebrow" data-reveal="up">Partners</p>
    <h2 class="sec-h" data-reveal="up">共催・協力団体</h2>
    <p class="sec-lede" data-reveal="up">関西のコミュニティと一緒につくります。</p>

    <div class="orgs" data-stagger>
      {
        rendered.map(({ data, Content }) => (
          <div class="org" style={`--rail:var(--${data.rail})`} data-reveal="up">
            <h3>
              <a href={data.url} target="_blank" rel="noopener">
                {data.name}
              </a>
            </h3>
            <p class="handle">{data.handle}</p>
            <div class="body">
              <Content />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bordered {
    border-top: var(--bw) solid var(--stroke);
    border-bottom: var(--bw) solid var(--stroke);
  }

  .orgs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }

  .org {
    border: var(--bw) solid var(--stroke);
    border-left: 7px solid var(--rail, var(--t));
    border-radius: var(--r-md);
    padding: 18px 20px;
    background: var(--surface);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .org h3 {
    font-size: 17px;
    margin-bottom: 4px;
  }

  .handle {
    font-family: var(--f-mono);
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .body :global(p) {
    font-size: 14px;
    line-height: 1.8;
    color: #3c4043;
  }
</style>
