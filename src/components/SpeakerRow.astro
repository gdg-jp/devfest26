---
import SpeakerAvatar from "./SpeakerAvatar.astro";
import { speakerHref, type Speaker } from "../data/program";

/**
 * Portrait, name, affiliation — the way a speaker is introduced everywhere
 * except on their own page.
 */
interface Props {
  speaker: Speaker;
  /**
   * Show the profile text under the affiliation. Only the pages that are about
   * these people ask for it: on the home page the cards are an index, and a
   * profile there would say the same thing as /speakers/<slug> while making
   * every card a different height.
   */
  bio?: boolean;
  /**
   * Hand the whole surrounding `.linkbox` to this person. For a card that is
   * about one speaker and nothing else, the name is what the frame leads to.
   */
  stretch?: boolean;
  size?: number;
}

const { speaker, bio = false, stretch = false, size } = Astro.props;
const profile = speaker.body?.trim();
---

<div class="one">
  {
    /* The portrait goes where the name goes. Hidden from assistive tech and
      from the tab order, because it is the same destination said twice — a
      screen reader gets the name, which is the version that says who. */
  }
  <a class="pic" href={speakerHref(speaker)} tabindex="-1" aria-hidden="true">
    <SpeakerAvatar speaker={speaker} size={size} />
  </a>
  <div class="who">
    <p class="nm">
      <a class:list={{ stretch }} href={speakerHref(speaker)}>
        {speaker.data.name}
      </a>
    </p>
    <p class="rl">{speaker.data.role}</p>
    {bio && profile && <p class="bio">{profile}</p>}
  </div>
</div>

<style>
  .one {
    display: flex;
    gap: 13px;
    align-items: flex-start;
  }

  /* An initial is text, so the link would draw its underline through it. */
  .pic {
    display: flex;
    flex: none;
    text-decoration: none;
  }

  .who {
    min-width: 0;
  }

  .nm {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
  }

  /* The link carries the name, so it reads as a name until it is hovered. */
  .nm a {
    color: inherit;
    text-decoration: none;
  }

  .nm a:hover {
    text-decoration: underline;
  }

  .rl {
    font-size: 12.6px;
    line-height: 1.6;
    color: #3c4043;
    margin: 0;
  }

  .bio {
    font-size: 12.6px;
    line-height: 1.75;
    color: #3c4043;
    margin: 7px 0 0;
  }
</style>
