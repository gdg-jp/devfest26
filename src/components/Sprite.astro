---
/**
 * Every vector a page draws, in one hidden sprite: the two DevFest lockups and
 * the sticker sheet. Sections reference them with <use href="#id">, so the
 * artwork is downloaded and parsed exactly once.
 *
 * The lockups paint themselves with var(--brand-ink), so they follow the theme.
 */
import logoPrimary from "../assets/brand/logo-primary.svg?raw";
import logoBrackets from "../assets/brand/logo-brackets.svg?raw";
import stickerSheet from "../assets/brand/stickers.svg?raw";

interface Props {
  /**
   * The sticker sheet is the biggest thing here and only the home page's
   * sections scatter it about. The pages behind the programme are chrome and
   * prose, so they leave it out rather than carry artwork nothing draws.
   */
  stickers?: boolean;
}

const { stickers = true } = Astro.props;
---

<svg class="sprite" aria-hidden="true" focusable="false">
  <defs>
    <g id="mk-primary" set:html={logoPrimary} />
    <g id="mk-brackets" set:html={logoBrackets} />
    {stickers && <g id="stickersheet" set:html={stickerSheet} />}
  </defs>
</svg>
