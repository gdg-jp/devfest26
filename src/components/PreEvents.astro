---
import type { ResolvedTenant } from "../tenants";
import { byTenant } from "../data/collections";
import MeetupCard from "./MeetupCard.astro";
import Gutter from "./Gutter.astro";
import Sticker from "./Sticker.astro";
import { messages } from "../i18n";
import { currentLanguage } from "../i18n/language";

/**
 * Deliberately quiet: plain ground, no colour band, running order folded away.
 * The loudest surface on the page belongs to the main event's own CTA, and a
 * pre-event that is four days out earns position — not visual weight.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const t = messages(currentLanguage());

const meetups = (await byTenant("meetups", site.tenant)).sort(
  (a, b) => a.data.no - b.data.no,
);
---

{
  /* A city with no pre-events announced yet renders nothing here. */
  meetups.length > 0 && (
    <section class="sec" id="preevent">
      <Gutter>
        <Sticker
          name="plus"
          width={66}
          top="12%"
          right="2.5%"
          rotate={-12}
          speed={0.8}
        />
        <Sticker name="dot" width={34} bottom="16%" left="2%" speed={-1.2} />
      </Gutter>

      <div class="wrap">
        <p class="eyebrow" data-reveal="up">
          Road to DevFest
        </p>
        <h2 class="sec-h" data-reveal="up">
          {t.preEvents.heading}
        </h2>
        <p class="sec-lede" data-reveal="up">
          {t.preEvents.lede(site.event.monthDay)}
        </p>

        <div class="meets" data-stagger>
          {meetups.map((m) => (
            <MeetupCard meetup={m} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .sec {
    padding-top: clamp(46px, 5.8vw, 74px);
    padding-bottom: clamp(46px, 5.8vw, 74px);
    border-bottom: var(--bw) solid var(--stroke);
  }

  .meets {
    display: grid;
    gap: 14px;
  }
</style>
