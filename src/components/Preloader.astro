---
import Logo from "./Logo.astro";
import type { ResolvedTenant } from "../tenants";

/**
 * First-paint curtain — the title card the day opens on.
 *
 * Four coloured rules rise through a dark stage and cross the mark: the same
 * four the tracks, the timetable and the whole brand are drawn in. The mark
 * itself is a pair of braces, so it arrives as that gesture — the braces clamp
 * in from the edges and the wordmark opens out between them — and the curtain
 * then lifts on a scalloped hem onto a hero set on the same dark ground.
 *
 * Visible only when <html> carries `.is-loading`, which the inline script in
 * Base.astro sets — and only for a first visit, with motion allowed. That same
 * script arms a timeout so a script that never loads cannot trap the page.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const { event } = site;

// `2026.10.18 SUN` — the one fact worth reading in the second the card is up.
const stamp = `${event.isoDate.replaceAll("-", ".")} ${event.dayOfWeekEn.toUpperCase()}`;
---

<div class="preloader" role="presentation" aria-hidden="true">
  <div class="pl-rules">
    <i style="--c:var(--blue); --i:0"></i>
    <i style="--c:var(--green); --i:1"></i>
    <i style="--c:var(--yellow); --i:2"></i>
    <i style="--c:var(--red); --i:3"></i>
  </div>

  <div class="pl-stack">
    <div class="pl-mark">
      <Logo variant="brackets" class="pl-brace pl-brace-l" label="" />
      <Logo variant="brackets" class="pl-word" label="" />
      <Logo variant="brackets" class="pl-brace pl-brace-r" label="" />
    </div>
    <p class="pl-stamp">{stamp}<span>{event.venue.cityEn}</span></p>
  </div>
</div>

<style>
  .preloader {
    display: none;
  }

  :global(html.is-loading) .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--stage);
    /* the wordmark inside the lockup paints itself with --brand-ink */
    --brand-ink: var(--on-stage);
    will-change: transform;
  }

  /* Scalloped hem, so the curtain leaves on the shape language it arrived in. */
  :global(html.is-loading) .preloader::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 30px;
    background: radial-gradient(
        circle at 22px 0,
        var(--stage) 21px,
        transparent 22px
      )
      repeat-x;
    background-size: 44px 30px;
  }

  /* The four core colours as four rules crossing the stage — the tracks of the
     day, before there is a timetable to put them in. Drawn behind the mark and
     scaled from the floor by the intro script. */
  .pl-rules {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    gap: clamp(46px, 11vw, 132px);
    overflow: hidden;
  }

  .pl-rules i {
    width: 2.5px;
    background: var(--c);
    transform: scaleY(0);
    transform-origin: bottom;
  }

  /* The rules run the full height of the card, so without this they cross the
     wordmark and the mark reads as struck through. A pool of the ground itself
     sits between the two and takes them out from under the type only. */
  .pl-rules::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      44% 26% at 50% 50%,
      var(--stage) 42%,
      color-mix(in srgb, var(--stage) 55%, transparent) 72%,
      transparent
    );
  }

  .pl-stack {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(20px, 3vw, 30px);
    padding: 24px;
  }

  /* The three copies of the lockup are stacked and each one is clipped to a
     different slice: two braces and the word between them. */
  .pl-mark {
    position: relative;
    width: min(340px, 68vw);
    aspect-ratio: 2532.7334 / 645.47467;
  }

  .pl-mark :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pl-mark :global(.pl-brace-l) {
    clip-path: inset(0 88% 0 0);
  }

  .pl-mark :global(.pl-brace-r) {
    clip-path: inset(0 0 0 88%);
  }

  .pl-mark :global(.pl-word) {
    clip-path: inset(0 12% 0 12%);
  }

  .pl-stamp {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--f-mono);
    font-size: clamp(11px, 1.5vw, 13px);
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--on-stage);
    opacity: 0;
  }

  .pl-stamp span {
    padding-left: 14px;
    border-left: 1.5px solid var(--stage-rule);
    color: var(--on-stage-dim);
    letter-spacing: 0.14em;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader,
    :global(html.is-loading) .preloader {
      display: none;
    }
  }
</style>
