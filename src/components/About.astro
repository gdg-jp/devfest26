---
import { render } from "astro:content";
import Gutter from "./Gutter.astro";
import Sticker from "./Sticker.astro";
import { inlineMarkdown } from "../lib/inlineMarkdown";
import { byTenant } from "../data/collections";

interface Props {
  tenant: string;
}

const { tenant } = Astro.props;

// At most one per city; a city that has not written its pitch renders nothing.
const entry = (await byTenant("about", tenant))[0];
const Content = entry ? (await render(entry)).Content : null;
---

{
  /* A city that has not written its About copy yet renders nothing here. */
  entry && Content && (
    <section class="sec tint bordered" id="about">
      <Gutter>
        <Sticker
          name="cross"
          width={70}
          top="9%"
          right="2.5%"
          rotate={-12}
          speed={0.9}
        />
        <Sticker
          name="braces"
          width={88}
          bottom="8%"
          left="1.5%"
          rotate={8}
          speed={-0.8}
        />
      </Gutter>

      <div class="wrap">
        <p class="eyebrow" data-reveal="up">
          About
        </p>
        <h2 class="sec-h" data-reveal="up">
          イベントについて
        </h2>

        <div class="split">
          <div data-reveal="up">
            <p class="lead">{entry.data.lead}</p>

            <div class="body">
              <Content />
            </div>

            {entry.data.callout && (
              <p class="callout">
                <i>{"{"}</i> {entry.data.callout} <i>{"}"}</i>
              </p>
            )}
          </div>

          {entry.data.audience && (
            <div class="panel fit" data-reveal="up">
              {entry.data.audience.eyebrow && (
                <p class="eyebrow tight">{entry.data.audience.eyebrow}</p>
              )}
              <h3>{entry.data.audience.heading}</h3>
              <ul>
                {entry.data.audience.items.map((item) => (
                  <li set:html={inlineMarkdown(item)} />
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .bordered {
    border-top: var(--bw) solid var(--stroke);
    border-bottom: var(--bw) solid var(--stroke);
  }

  .split {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: clamp(18px, 2.6vw, 30px);
    align-items: start;
  }

  @media (width <= 880px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .lead {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(18px, 2.5vw, 25px);
    line-height: 1.6;
    margin-bottom: 0.9em;
  }

  .callout {
    border: var(--bw) solid var(--t);
    border-radius: var(--r-md);
    padding: 16px 20px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(15px, 1.9vw, 18px);
    line-height: 1.7;
    margin-top: 22px;
    background: var(--surface);
  }

  .callout i {
    font-style: normal;
    color: var(--t);
  }

  .body :global(p + p) {
    margin-top: 1.05em;
  }

  .fit {
    background: var(--t-pa);
  }

  .eyebrow.tight {
    margin-bottom: 10px;
  }

  .fit h3 {
    font-size: 20px;
    margin-bottom: 14px;
  }

  .fit ul {
    margin: 0;
    padding-left: 1.15em;
    font-size: 14.6px;
    line-height: 1.95;
  }

  .fit li::marker {
    color: var(--t);
  }

  /* Emphasis arrives from Markdown and from set:html, so it is out of scope. */
  .body :global(strong),
  .fit li :global(strong) {
    background: linear-gradient(transparent 62%, var(--ht-yellow) 62%);
  }
</style>
