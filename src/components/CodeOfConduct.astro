---
import type { ResolvedTenant } from "../tenants";
import { messages } from "../i18n";
import { language } from "../i18n/language";

interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const t = messages(language);
---

<section class="sec" id="coc">
  <div class="wrap">
    <p class="eyebrow" data-reveal="up">Safety</p>
    <h2 class="sec-h" data-reveal="up">{t.codeOfConduct.heading}</h2>

    <div class="rules" data-stagger>
      <div class="panel harassment" data-reveal="up">
        <h3>{t.codeOfConduct.harassmentTitle}</h3>
        <p>
          {t.codeOfConduct.harassmentIntro}
        </p>
        <ul>
          {t.codeOfConduct.harassmentItems.map((item) => <li>{item}</li>)}
        </ul>
        <p>
          {t.codeOfConduct.harassmentFooter}
        </p>
      </div>

      <div class="panel" data-reveal="up">
        <h3>{t.codeOfConduct.cocTitle}</h3>
        <p>
          {t.codeOfConduct.cocDesc}
        </p>
        <div class="cta-row">
          <a
            class="btn sm ghost"
            href={site.links.cocJa}
            target="_blank"
            rel="noopener"
          >
            {t.codeOfConduct.cocJaLabel}
          </a>
          <a
            class="btn sm ghost"
            href={site.links.cocEn}
            target="_blank"
            rel="noopener"
          >
            {t.codeOfConduct.cocEnLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    align-items: start;
  }

  @media (width <= 820px) {
    .rules {
      grid-template-columns: 1fr;
    }
  }

  .panel {
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .harassment {
    border-color: var(--red);
  }

  h3 {
    font-size: 19px;
  }

  p {
    font-size: 14.4px;
    line-height: 1.9;
    margin-top: 10px;
  }

  ul {
    margin: 10px 0 0;
    padding-left: 1.15em;
    font-size: 14.4px;
    line-height: 1.9;
  }

  li::marker {
    color: var(--t);
  }

  .cta-row {
    margin-top: 16px;
  }
</style>
