---
import Base from "./Base.astro";
import Sprite from "../components/Sprite.astro";
import Preloader from "../components/Preloader.astro";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";
import type { ResolvedTenant } from "../tenants";
import type { NavItem } from "../tenants/types";

/**
 * The frame of a city's home page: the intro curtain, the top bar and the
 * footer. The sections between them are the page's own, passed in as
 * children.
 *
 * Split out so that a city writing its own home page, in
 * `src/routes/<slug>/index.astro`, chooses only what goes between — which
 * sections, in what order, and what of its own — and keeps the same frame as
 * every other city without copying it.
 */
interface Props {
  site: ResolvedTenant;
  /** This page's own section links, when they are not the city's. */
  nav?: readonly NavItem[];
  /** The same for the footer's longer list. */
  footerNav?: readonly NavItem[];
}

const { site, nav, footerNav } = Astro.props;
---

<Base site={site}>
  <Sprite />
  <Preloader site={site} />

  <TopBar site={site} nav={nav} />
  <main>
    <slot />
  </main>
  <Footer site={site} nav={footerNav} />
</Base>
