{
  "name": "devfest-2026",
  "type": "module",
  "version": "0.0.1",
  "description": "DevFest 2026 のイベントページ（マルチテナント：開催地は Sanity の event ドキュメントから）",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "dotenv -- astro dev",
    "dev:portal": "cross-env TARGETS=portal dotenv -- astro dev",
    "build": "dotenv -- astro build",
    "build:portal": "cross-env TARGETS=portal dotenv -- astro build",
    "preview:build": "cross-env PREVIEW=1 dotenv -- astro build",
    "preview:dev": "cross-env PREVIEW=1 dotenv -- astro dev",
    "preview:deploy": "wrangler deploy -c dist/all/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "dotenv -- astro check && tsc --noEmit",
    "check:portal": "cross-env TARGETS=portal dotenv -- astro check",
    "targets": "dotenv -- node --experimental-strip-types scripts/discover-targets.mjs",
    "og": "dotenv -- node --experimental-strip-types scripts/make-og.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check:preview": "tsc --noEmit -p preview/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.4.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/visual-editing": "^6.1.1",
    "astro": "^7.2.4",
    "motion": "^13.1.1",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20250726.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.127.1"
  }
}
