{
  "name": "devfest-2026",
  "type": "module",
  "version": "0.0.1",
  "description": "DevFest 2026 のイベントページ（マルチテナント：開催地は Sanity の event ドキュメントから）",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "dotenv -- astro dev",
    "dev:portal": "cross-env TARGETS=portal dotenv -- astro dev",
    "build": "dotenv -- astro build",
    "build:portal": "cross-env TARGETS=portal dotenv -- astro build",
    "preview:build": "cross-env PREVIEW=1 dotenv -- astro build",
    "preview:dev": "cross-env PREVIEW=1 dotenv -- astro dev",
    "preview:deploy": "wrangler deploy -c dist/ja-all/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "dotenv -- astro check && tsc --noEmit",
    "check:portal": "cross-env TARGETS=portal dotenv -- astro check",
    "targets": "dotenv -- node --experimental-strip-types scripts/discover-targets.mjs",
    "og:session": "dotenv -- tsx scripts/og.ts session",
    "og:sessions": "dotenv -- tsx scripts/og.ts sessions",
    "og:card": "tsx scripts/og.ts card",
    "og:stickers": "tsx scripts/og-stickers.ts && prettier --write src/lib/og/stickerShapes.ts",
    "og:faces": "dotenv -- tsx scripts/og-faces.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check:preview": "tsc --noEmit -p preview/tsconfig.json",
    "migrate:talks": "dotenv -- node scripts/migrate-talks-to-sessions.mjs",
    "migrate:talks:dry": "dotenv -- node scripts/migrate-talks-to-sessions.mjs --dry-run",
    "migrate:i18n": "dotenv -- node scripts/migrate-to-i18n.mjs",
    "migrate:i18n:dry": "dotenv -- node scripts/migrate-to-i18n.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.11.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/visual-editing": "^6.2.0",
    "astro": "^7.4.2",
    "budoux": "^0.10.0",
    "motion": "^14.6.0",
    "openid-client": "^6.8.8",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.152.0"
  }
}
