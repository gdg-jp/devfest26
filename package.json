{
  "name": "devfest-2026",
  "type": "module",
  "version": "0.0.1",
  "description": "DevFest 2026 のイベントページ（マルチテナント：関西・東京）",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "dotenv -- astro dev",
    "dev:tokyo": "cross-env TENANT=tokyo astro dev",
    "dev:portal": "cross-env PORTAL=1 astro dev",
    "build": "dotenv -- astro build",
    "build:kansai": "cross-env TENANT=kansai astro build",
    "build:tokyo": "cross-env TENANT=tokyo astro build",
    "build:portal": "cross-env PORTAL=1 astro build",
    "build:all": "pnpm build:kansai && pnpm build:tokyo && pnpm build:portal",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:all": "astro check && cross-env TENANT=tokyo astro check && cross-env PORTAL=1 astro check",
    "og": "node --experimental-strip-types scripts/make-og.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.4.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.2.4",
    "motion": "^13.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
