{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "devfest26-preview",
  // The gate, not Astro's handler. `@astrojs/cloudflare` only fills this in
  // when it is absent, so naming it here is what puts authentication in front
  // of the site — see `src/index.ts`.
  "main": "./src/index.ts",
  // Not "today": workerd only knows dates up to the release it ships in, and a
  // date past that is a hard error rather than a warning.
  "compatibility_date": "2026-07-25",
  // openid-client reaches for a few Node built-ins, and so does the Astro
  // server bundle.
  "compatibility_flags": ["nodejs_compat"],

  // The site's client build, uploaded with the Worker: stylesheets, scripts,
  // images, `public/`. The pages themselves are not in here any more — they
  // are rendered per request from the drafts, which is the whole point — so
  // `directory` is left to the adapter, which knows where its own client
  // output went.
  "assets": {
    "binding": "ASSETS",
    // `astro.config.ts` sets `trailingSlash: "never"`, so `/kansai/` is not a
    // second URL for the same page — it is redirected to `/kansai`.
    "html_handling": "drop-trailing-slash",
    /*
      The whole point of the first rule. Without it Cloudflare answers asset
      requests before the Worker ever runs, and the gate would only cover the
      paths that do not match a file — which is none of them.

      The exclusions after it are the five URL namespaces a Vite dev server
      answers from, and they are here because `astro dev` runs this same
      config: `@cloudflare/vite-plugin` turns these rules into its dev routing,
      and anything sent to the Worker never reaches Vite's own middleware. With
      `run_worker_first: true` that is every request, so the dev server serves
      no stylesheet and no client script at all — the page renders and then
      nothing on it moves.

      They cost the deployment nothing. The built Worker's assets are `_astro/`
      and a copy of `public/`; no file it uploads lives under any of these, so
      the asset router answers each of them 404 without the Worker running,
      which is what it would have answered anyway.
    */
    "run_worker_first": [
      "/*",
      // Vite's own client, and its HMR plumbing.
      "!/@vite/*",
      // Resolved bare and virtual module ids — Astro's dev toolbar arrives here.
      "!/@id/*",
      // Files outside the project root: linked packages, the pnpm store.
      "!/@fs/*",
      // The source tree itself, which is most of a dev module graph.
      "!/src/*",
      // Pre-bundled dependencies, under `node_modules/.vite/deps`.
      "!/node_modules/*"
    ]
  },

  "vars": {
    "IDP_ISSUER": "https://accounts.gdgs.jp",
    // Fill in after registering this Worker as a client in GDG Accounts. A
    // client id is public — it is in the authorization URL every visitor
    // follows — so it belongs here rather than in a secret. Until it is set
    // the Worker serves the setup page instead of the site, and that page
    // prints the URLs to register.
    "IDP_CLIENT_ID": "26f52d5a-2dbe-4962-8f2e-9b75e23c3986"
  },

  // Per-version preview URLs would be gated by this same Worker, but their
  // hostname is not the registered redirect URI, so signing in from one fails
  // with a mismatch. One URL, which is the one people are given.
  "preview_urls": false,

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
