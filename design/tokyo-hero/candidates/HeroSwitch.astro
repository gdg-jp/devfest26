---
/**
 * Development only: a strip in the corner for flipping between the key
 * visual candidates (`?hero=a` …). `Home` leaves it out of every build.
 *
 * Every candidate is on the page, all but `current` hidden; the script, which
 * runs as soon as it is parsed, shows the one the query asks for instead.
 */
interface Props {
  options: { id: string; label: string }[];
  current: string;
}

const { options, current } = Astro.props;
---

<nav class="tkh-switch" aria-label="Key visual candidates">
  <span>Hero</span>
  {
    options.map(({ id, label }) => (
      <a
        href={`?hero=${id}`}
        aria-current={id === current ? "true" : undefined}
        title={label}
      >
        {id.toUpperCase()}
        <small>{label}</small>
      </a>
    ))
  }
</nav>

<script is:inline>
  (function () {
    const asked = new URLSearchParams(location.search).get("hero");
    const all = document.querySelectorAll("[data-tk-hero-candidate]");
    const known = Array.prototype.some.call(all, function (el) {
      return el.getAttribute("data-tk-hero-candidate") === asked;
    });
    if (!known) return;
    all.forEach(function (el) {
      el.hidden = el.getAttribute("data-tk-hero-candidate") !== asked;
    });
    document.querySelectorAll(".tkh-switch a").forEach(function (a) {
      if (a.getAttribute("href") === "?hero=" + asked) {
        a.setAttribute("aria-current", "true");
      } else {
        a.removeAttribute("aria-current");
      }
    });
  })();
</script>

<style>
  .tkh-switch {
    position: fixed;
    z-index: 1000;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    font: 600 12px/1 var(--tk-f-display);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.15);
  }

  .tkh-switch > span {
    padding: 0 6px 0 8px;
    color: var(--muted, #666);
  }

  .tkh-switch a {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: 7px 11px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
  }

  .tkh-switch a small {
    font-weight: 500;
    font-size: 11px;
  }

  .tkh-switch a[aria-current] {
    background: var(--ink);
    color: var(--surface);
  }

  @media (width < 700px) {
    .tkh-switch a small {
      display: none;
    }
  }
</style>
