---
import Org from "./Org.astro";
import Ctas from "./Ctas.astro";
import type { ResolvedTenant } from "../../../../tenants";
import { currentLanguage } from "../../../../i18n/language";
import { heroFacts } from "./facts";
import { BRACE, BRACE_STROKE, BRACE_TRANSFORM, BRACE_VIEWBOX } from "./brace";

/**
 * Key visual A, "Wave": Kansai's, in Tokyo's colour. The same frame — the
 * organiser and a symbol in the top corners, the name between the DevFest
 * braces, the catch, a card with the day and the place, two buttons — so the
 * two cities read as one series. What changes is what floats around it: line
 * drawings of the theme, vibes — a sound wave, a level meter, a cursor, a
 * chat bubble — some of them moving to a beat.
 *
 * The name is retyped as the theme's two halves, Meet the Vibes and Beyond
 * the Vibes, and the braces swap their two reds on each word.
 */
interface Props {
  site: ResolvedTenant;
}

const { site } = Astro.props;
const lang = currentLanguage();
const f = heroFacts(site, lang);
const [first] = f.words;

// One period of the wave is 120 units; three of them, so the drawing can
// slide one period left and loop without a seam.
const WAVE = `M0 30 ${Array.from({ length: 6 }, () => "q30 -30 60 0 q30 30 60 0").join(" ")}`;
---

<section class="tkh-a" aria-labelledby="tkh-a-title" data-tkh-a>
  <Org facts={f} />

  <div class="tkh-a__sym" aria-hidden="true">
    <svg class="tkh-a__point" viewBox="0 0 196.5 151.5">
      <g
        transform="translate(-2232.5 -197.5)"
        fill="none"
        stroke="currentColor"
        stroke-width="10"
        stroke-linecap="round"
      >
        <line x1="2240.97" y1="273.19" x2="2420.74" y2="273.19"></line>
        <path d="M2420.74,273.19c-37.42,0-88.8-30.13-89.49-67.45"></path>
        <path d="M2420.74,273.19c-37.45,0-88.88,30.17-89.49,67.53"></path>
      </g>
    </svg>
    <svg class="tkh-a__spark" viewBox="0 0 100 100">
      <path
        d="M50 4C54 38 62 46 96 50C62 54 54 62 50 96C46 62 38 54 4 50C38 46 46 38 50 4Z"
      ></path>
    </svg>
  </div>

  <div class="tkh-a__field" aria-hidden="true">
    <svg class="tkh-a__shape tkh-a__wave" viewBox="0 0 240 60">
      <g><path d={WAVE}></path></g>
    </svg>
    <svg class="tkh-a__shape tkh-a__eq" viewBox="0 0 124 92">
      {
        [0, 1, 2, 3, 4].map((i) => (
          <rect
            x={4 + i * 24}
            y="4"
            width="18"
            height="84"
            rx="9"
            style={`--i:${i}`}
          />
        ))
      }
    </svg>
    <svg class="tkh-a__shape tkh-a__cursor" viewBox="0 0 96 110">
      <path d="M10 8 10 84 30 66 44 98 60 91 46 60 76 60Z"></path>
      <path class="tkh-a__click" d="M70 14 80 4M80 30 94 28M56 6 56 -6"></path>
    </svg>
    <svg class="tkh-a__shape tkh-a__bubble" viewBox="0 0 150 110">
      <path
        d="M30 6h90a24 24 0 0 1 24 24v34a24 24 0 0 1-24 24H58L32 106l4-18h-6A24 24 0 0 1 6 64V30A24 24 0 0 1 30 6Z"
      ></path>
      <circle cx="48" cy="47" r="7"></circle>
      <circle cx="75" cy="47" r="7"></circle>
      <circle cx="102" cy="47" r="7"></circle>
    </svg>
    <svg class="tkh-a__shape tkh-a__ripple" viewBox="0 0 80 110">
      <path d="M10 30a30 30 0 0 1 0 50"></path>
      <path d="M30 14a52 52 0 0 1 0 82"></path>
      <path d="M50 -2a74 74 0 0 1 0 114"></path>
    </svg>
    <svg class="tkh-a__shape tkh-a__asterisk" viewBox="0 0 80 80">
      <path d="M40 6v68M10.6 23 69.4 57M10.6 57 69.4 23"></path>
    </svg>
    <svg class="tkh-a__shape tkh-a__dot" viewBox="0 0 40 40">
      <circle cx="20" cy="20" r="16"></circle>
    </svg>
  </div>

  <div class="tkh-a__intro">
    <p class="tkh-a__by">{f.text("by")}</p>

    <h1 class="tkh-a__title" id="tkh-a-title">
      <span class="visually-hidden">{site.title}</span>
      <span class="tkh-a__mark" aria-hidden="true" data-tkh-a-mark>
        <svg class="tkh-a__brace tkh-a__brace--l" viewBox={BRACE_VIEWBOX.left}>
          <path
            d={BRACE}
            transform={BRACE_TRANSFORM.left}
            stroke-width={BRACE_STROKE}></path>
        </svg>
        <span class="tkh-a__type">
          <span class="tkh-a__word" data-tkh-a-word={JSON.stringify(f.words)}
            >{first}</span
          ><span class="tkh-a__caret"></span>
        </span>
        <svg class="tkh-a__brace tkh-a__brace--r" viewBox={BRACE_VIEWBOX.right}>
          <path
            d={BRACE}
            transform={BRACE_TRANSFORM.right}
            stroke-width={BRACE_STROKE}></path>
        </svg>
      </span>
    </h1>

    <p class="tkh-a__catch">
      {
        f.catchLines.map((line) => (
          <span>{line.map(({ run, em }) => (em ? <em>{run}</em> : run))}</span>
        ))
      }
    </p>

    <div class="tkh-a__card">
      <dl class="tkh-a__facts">
        <div>
          <dt class="visually-hidden">Date</dt>
          <dd class="tkh-a__when">
            <span class="tkh-a__year">{f.year}</span>
            <time class="tkh-a__date" datetime={f.startsAt}>
              <span class="tkh-a__md">{f.month}.{f.day}</span>
              <span class="tkh-a__dow">({f.dow})</span>
              <span class="tkh-a__hours">
                <span>{f.start}</span>
                <span>~{f.end}</span>
              </span>
            </time>
          </dd>
        </div>
        <div>
          <dt class="visually-hidden">Venue</dt>
          <dd class="tkh-a__place">
            <span class="tkh-a__access"
              ><span class="tkh-a__at">@</span>{f.station}<b>{f.walk}</b></span
            >
            <span class="tkh-a__venue">{f.venue}</span>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="tkh-a__ctas">
    <Ctas site={site} facts={f} />
  </div>
</section>

<script>
  /*
    Retypes the name as each word in turn: hold, back out a letter at a time,
    swap the braces' reds, type the next. Holds still for reduced motion.
  */
  const mark = document.querySelector<HTMLElement>("[data-tkh-a-mark]");
  const word = mark?.querySelector<HTMLElement>("[data-tkh-a-word]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (mark && word && !reduced) {
    const words: string[] = JSON.parse(word.dataset.tkhAWord ?? "[]");
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let n = 0;

    const loop = async () => {
      for (;;) {
        await wait(2600);
        mark.classList.add("is-typing");
        for (let s = words[n]; s.length;) {
          s = s.slice(0, -1);
          word.textContent = s;
          await wait(38);
        }
        n = (n + 1) % words.length;
        mark.classList.toggle("is-flipped");
        await wait(220);
        for (let i = 1; i <= words[n].length; i++) {
          word.textContent = words[n].slice(0, i);
          await wait(70);
        }
        mark.classList.remove("is-typing");
      }
    };
    loop();
  }
</script>

<style>
  .tkh-a {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: clip;
  }

  .tkh-a__intro {
    --s: 0.8;
    --title-base: calc(clamp(48px, 8.6vw, 164px) * var(--s));
    --title: calc(var(--title-base) * 1.2);
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2.4vh, 26px);
    padding: clamp(72px, 10vh, 104px) var(--tk-gutter) clamp(20px, 3vh, 36px);
    text-align: center;
  }

  .tkh-a__by {
    margin: 0 0 calc(clamp(14px, 2.4vh, 26px) * -0.6);
    font-family: var(--tk-f-display);
    font-weight: 500;
    font-size: calc(var(--title-base) * 0.26);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* ---- the mark ----------------------------------------------------- */

  .tkh-a__title {
    margin: 0;
    font-size: var(--title);
  }

  .tkh-a__mark {
    display: flex;
    align-items: center;
    gap: 0.08em;
    line-height: 1;
  }

  .tkh-a__brace {
    flex: none;
    width: auto;
    height: 1.2em;
    overflow: visible;
  }

  .tkh-a__brace path {
    stroke: var(--ink);
    transition: fill 0.45s var(--tk-ease);
  }

  /* The session cards' two reds (see `src/lib/og/render.ts`): pale on the
     left, the brand red on the right, swapping with each word. */
  .tkh-a__brace--l path,
  .tkh-a__mark:global(.is-flipped) .tkh-a__brace--r path {
    fill: var(--tk-accent-pa);
  }

  .tkh-a__brace--r path,
  .tkh-a__mark:global(.is-flipped) .tkh-a__brace--l path {
    fill: var(--tk-accent);
  }

  .tkh-a__type {
    padding: 0 0.04em 0.06em;
    white-space: nowrap;
  }

  .tkh-a__word {
    font-family: var(--tk-f-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    white-space: pre;
  }

  .tkh-a__caret {
    display: inline-block;
    vertical-align: -0.1em;
    width: 0.06em;
    height: 0.86em;
    margin-left: 0.04em;
    border-radius: 0.03em;
    background: var(--tk-accent);
    animation: tkh-a-blink 1.05s steps(1) infinite;
  }

  .tkh-a__mark:global(.is-typing) .tkh-a__caret {
    animation: none;
  }

  @keyframes tkh-a-blink {
    50% {
      opacity: 0;
    }
  }

  /* ---- catch -------------------------------------------------------- */

  .tkh-a__catch {
    display: grid;
    gap: 0.15em;
    margin: 0;
    font-family: var(--tk-f-jp);
    font-weight: 800;
    font-size: calc(clamp(22px, 2.8vw, 46px) * var(--s) * 1.1);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .tkh-a__catch em {
    font-style: normal;
    background: linear-gradient(
      transparent 62%,
      var(--tk-accent-ht) 62% 92%,
      transparent 92%
    );
  }

  /* ---- the card ----------------------------------------------------- */

  .tkh-a__card {
    width: fit-content;
    max-width: 100%;
    padding: clamp(16px, 2vw, 26px) clamp(22px, 2.6vw, 34px)
      clamp(16px, 2vw, 24px);
    border: var(--tk-line) solid var(--ink);
    border-radius: var(--tk-r-xl);
    background: var(--surface);
    text-align: left;
  }

  @supports (corner-shape: squircle) {
    .tkh-a__card {
      border-radius: 48px;
      corner-shape: squircle;
    }
  }

  /* 2026         12:00
     11.29 (日)   ~18:00
     @東京駅から徒歩約 1 分  JP タワー … */
  .tkh-a__facts {
    --big: clamp(44px, 4.4vw, 64px);
    display: grid;
    gap: 2px;
    margin: 0;
    font-family: var(--tk-f-display);
    font-weight: 700;
    line-height: 1.15;
  }

  .tkh-a__facts dd {
    margin: 0;
  }

  /* Room above the date for the year: Tokyo has no line over the hours to
     push it down, as Kansai's "オンラインあり" does. */
  .tkh-a__when {
    position: relative;
    padding-top: calc(var(--big) * 0.32);
  }

  .tkh-a__year {
    position: absolute;
    top: 0;
    left: 0;
    font-size: calc(var(--big) * 0.42);
    letter-spacing: -0.01em;
  }

  .tkh-a__date {
    display: block;
    white-space: nowrap;
  }

  .tkh-a__md {
    font-size: var(--big);
    letter-spacing: -0.035em;
  }

  .tkh-a__dow {
    margin-left: 0.1em;
    font-family: var(--tk-f-jp);
    font-size: calc(var(--big) * 0.34);
  }

  .tkh-a__hours {
    display: inline-block;
    margin-left: 0.5em;
    padding-top: 0.3em;
    font-size: calc(var(--big) * 0.36);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .tkh-a__hours > * {
    display: block;
  }

  .tkh-a__place {
    display: grid;
    gap: 2px;
    margin-top: 14px;
  }

  .tkh-a__access {
    font-family: var(--tk-f-jp);
    font-weight: 700;
    font-size: calc(var(--big) * 0.3);
  }

  .tkh-a__at {
    margin-right: 0.1em;
    font-family: var(--tk-f-display);
  }

  .tkh-a__access b {
    margin-left: 0.3em;
    font-weight: 800;
    font-size: 1.15em;
    background: linear-gradient(
      transparent 60%,
      var(--ht-yellow) 60% 92%,
      transparent 92%
    );
  }

  .tkh-a__venue {
    font-family: var(--tk-f-jp);
    font-weight: 500;
    font-size: max(12px, calc(var(--big) * 0.24));
  }

  /* ---- the corners -------------------------------------------------- */

  .tkh-a__sym {
    position: absolute;
    z-index: 2;
    top: clamp(16px, 2.4vw, 28px);
    right: var(--tk-gutter);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tkh-a__point {
    width: clamp(38px, 3.6vw, 52px);
    height: auto;
    scale: -1 1;
  }

  .tkh-a__spark {
    width: clamp(40px, 3.8vw, 54px);
    height: auto;
    overflow: visible;
  }

  .tkh-a__spark path {
    fill: var(--tk-accent-ht);
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linejoin: round;
  }

  .tkh-a__ctas {
    position: relative;
    z-index: 2;
    padding: 0 var(--tk-gutter)
      calc(clamp(24px, 4vh, 44px) + env(safe-area-inset-bottom));
  }

  /* ---- the field: line drawings of the theme ------------------------- */

  .tkh-a__field {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .tkh-a__shape {
    position: absolute;
    height: auto;
    overflow: visible;
  }

  .tkh-a__shape :global(*) {
    fill: none;
    stroke: var(--ink);
    stroke-width: var(--tk-line);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .tkh-a__wave {
    top: 24%;
    left: 5%;
    width: clamp(140px, 15vw, 230px);
    overflow: hidden;
  }

  .tkh-a__eq {
    bottom: 20%;
    left: 8%;
    width: clamp(80px, 8vw, 124px);
  }

  .tkh-a__eq rect {
    fill: var(--tk-accent-ht);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .tkh-a__cursor {
    bottom: 24%;
    right: 11%;
    width: clamp(46px, 4.4vw, 70px);
  }

  .tkh-a__cursor path:first-child {
    fill: var(--surface);
  }

  .tkh-a__bubble {
    top: 46%;
    right: 3.5%;
    width: clamp(90px, 9vw, 140px);
    rotate: 6deg;
  }

  .tkh-a__bubble path {
    fill: var(--surface);
  }

  .tkh-a__bubble circle {
    fill: var(--ink);
  }

  .tkh-a__ripple {
    top: 48%;
    left: 3%;
    width: clamp(40px, 4vw, 64px);
  }

  .tkh-a__asterisk {
    top: 17%;
    right: 24%;
    width: clamp(30px, 3vw, 46px);
  }

  .tkh-a__dot {
    top: 15%;
    left: 28%;
    width: 18px;
  }

  .tkh-a__dot circle {
    fill: var(--tk-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tkh-a__wave g {
      animation: tkh-a-flow 2.4s linear infinite;
    }

    .tkh-a__eq rect {
      animation: tkh-a-level 1.2s var(--tk-ease-io) infinite alternate;
      animation-delay: calc(var(--i) * -0.37s);
    }

    .tkh-a__ripple path {
      animation: tkh-a-ripple 1.8s ease-out infinite;
    }

    .tkh-a__ripple path:nth-child(2) {
      animation-delay: 0.2s;
    }

    .tkh-a__ripple path:nth-child(3) {
      animation-delay: 0.4s;
    }

    .tkh-a__click {
      animation: tkh-a-click 2.4s ease-in-out infinite;
    }

    .tkh-a__spark path {
      transform-box: fill-box;
      transform-origin: center;
      animation: tkh-a-twinkle 3.2s var(--tk-ease) infinite;
    }

    .tkh-a__asterisk {
      animation: tkh-a-spin 14s linear infinite;
    }

    .tkh-a__bubble circle {
      animation: tkh-a-typing 1.2s ease-in-out infinite;
    }

    .tkh-a__bubble circle:nth-of-type(2) {
      animation-delay: 0.15s;
    }

    .tkh-a__bubble circle:nth-of-type(3) {
      animation-delay: 0.3s;
    }

    .tkh-a__point g {
      animation: tkh-a-nudge 1.8s ease-in-out infinite;
    }
  }

  @keyframes tkh-a-flow {
    to {
      transform: translateX(-120px);
    }
  }

  @keyframes tkh-a-level {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes tkh-a-ripple {
    0%,
    100% {
      opacity: 0.15;
    }
    30% {
      opacity: 1;
    }
  }

  @keyframes tkh-a-click {
    0%,
    60%,
    100% {
      opacity: 0;
    }
    70%,
    85% {
      opacity: 1;
    }
  }

  @keyframes tkh-a-twinkle {
    0%,
    70%,
    100% {
      transform: scale(1) rotate(0);
    }
    80% {
      transform: scale(1.18) rotate(20deg);
    }
  }

  @keyframes tkh-a-spin {
    to {
      rotate: 1turn;
    }
  }

  @keyframes tkh-a-typing {
    0%,
    60%,
    100% {
      translate: 0 0;
    }
    30% {
      translate: 0 -6px;
    }
  }

  @keyframes tkh-a-nudge {
    50% {
      translate: 14px 0;
    }
  }

  /* ---- narrow ------------------------------------------------------- */

  @media (width < 860px) {
    .tkh-a__intro {
      --title-base: calc(clamp(40px, 12.4vw, 104px) * var(--s));
    }

    .tkh-a__by {
      font-size: calc(clamp(18px, 5vw, 28px) * var(--s));
    }

    /* The name on two lines between taller braces, with room for two lines
       whatever is typed, so nothing below jumps. */
    .tkh-a__mark {
      align-items: stretch;
      min-height: 2.1em;
    }

    .tkh-a__type {
      align-self: center;
      max-width: 5.4em;
      white-space: normal;
    }

    .tkh-a__word {
      white-space: pre-wrap;
      line-height: 1.02;
    }

    .tkh-a__brace {
      height: auto;
      align-self: stretch;
      width: 0.62em;
    }

    .tkh-a__facts {
      --big: clamp(40px, 11vw, 52px);
    }

    /* Only the drawings that stay clear of the words. */
    .tkh-a__eq,
    .tkh-a__cursor,
    .tkh-a__bubble,
    .tkh-a__ripple,
    .tkh-a__asterisk {
      display: none;
    }

    .tkh-a__wave {
      top: 11%;
      left: auto;
      right: -12px;
      width: 110px;
    }

    .tkh-a__dot {
      top: 12%;
      left: 12%;
    }
  }

  /* Two chapters' names need the corner the arrow points from. */
  @media (width < 560px) {
    .tkh-a__point {
      display: none;
    }
  }
</style>
